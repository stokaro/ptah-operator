FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 \
    go build -trimpath -ldflags="-s -w" -o /out/manager ./cmd/manager
RUN CGO_ENABLED=0 \
    go build -trimpath -ldflags="-s -w" -o /out/ptah-runner ./cmd/ptah-runner
RUN CGO_ENABLED=0 \
    go build -trimpath -ldflags="-s -w" -o /out/e2e-handcraft-oci ./test/e2e/handcraftoci

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7 AS operator
COPY --from=builder /out/manager /manager
COPY --from=builder /out/ptah-runner /ptah-runner
USER 65532:65532
ENTRYPOINT ["/manager"]

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7 AS fixture
COPY --from=builder /out/e2e-handcraft-oci /e2e-handcraft-oci
USER 65532:65532
ENTRYPOINT ["/e2e-handcraft-oci"]
