#!/bin/sh
# The demonstration lab's own commands.
#
# A scenario step runs this rather than forty lines of jq, and every one of
# those lines is in demo/lib/lab.sh where a reader can follow it. What a step
# publishes is the command a reader would run against their own lab after
# cloning this repository.
set -eu

LAB_ROOT=${LAB_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)}
export LAB_ROOT

# The environment the bootstrap wrote. Every name below comes from it.
LAB_ENVIRONMENT=${LAB_ENVIRONMENT:-$LAB_ROOT/demo/.lab/environment}

. "$LAB_ROOT/demo/lib/support.sh"
. "$LAB_ROOT/demo/lib/lab.sh"

# read_environment loads what the bootstrap wrote. Every command but `up` and
# `down` needs it, and a missing file is a lab nobody built rather than a
# condition to work around.
read_environment() {
	[ -f "$LAB_ENVIRONMENT" ] || {
		printf 'lab: no lab at %s; bring one up with make demo-up\n' "$LAB_ENVIRONMENT" >&2
		exit 1
	}
	set -a
	# shellcheck disable=SC1090 # The path is the lab's, and it is a NAME=value file.
	. "$LAB_ENVIRONMENT"
	set +a
	LAB_POSTGRES_IMAGE=${E2E_POSTGRES_IMAGE:-}
	export LAB_POSTGRES_IMAGE
	export DOCKER_CONFIG="${E2E_DOCKER_CONFIG:-${DOCKER_CONFIG:-}}"
	# kind takes its daemon from the environment, not from a Docker context, so
	# without these it looks at a local daemon and reports no such cluster --
	# which reads exactly like a cluster that is already gone.
	if [ -n "${E2E_DOCKER_ENDPOINT:-}" ]; then
		export DOCKER_HOST="$E2E_DOCKER_ENDPOINT"
		export KIND_EXPERIMENTAL_PROVIDER=docker
	fi
}

lab_usage() {
	cat >&2 <<'USAGE'
usage: demo/bin/lab <command>

  up                   build the lab, unless one is already up, and prepare it
  down                 remove the cluster and the containers the lab created
  prepare              create the namespace, its routes, credentials and policy
  reset                remove every schema, plan and approval, and empty the database
  manifest <name> <digest>
                       render demo/manifests/<name>.yaml for this lab
  credentials          print the registry credentials this lab generated
  tools                print a directory holding ptah and kubectl-ptah, building them once
  registry             print the address a publishing client uses
  namespace            print the namespace the lab runs in
  kubeconfig           print the kubeconfig file of the lab's own cluster
  versions             print what the lab is made of
USAGE
	exit 2
}

[ "$#" -gt 0 ] || lab_usage
lab_command=$1
shift

case "$lab_command" in
up) lab_up ;;
down) lab_down ;;
prepare)
	read_environment
	lab_prepare
	;;
reset)
	read_environment
	lab_reset
	;;
credentials)
	read_environment
	lab_credentials
	;;
manifest)
	[ "$#" -eq 2 ] || lab_usage
	read_environment
	lab_manifest "$1" "$2"
	;;
tools)
	read_environment
	lab_tools
	;;
registry)
	read_environment
	lab_registry_address
	;;
namespace)
	read_environment
	printf '%s\n' "$E2E_TEST_NAMESPACE"
	;;
kubeconfig)
	# The lab's cluster is reachable only through the file kind wrote for it,
	# and a command run in a reader's own shell inherits that shell's context
	# rather than the lab's. A child process cannot export a variable into its
	# parent, so printing the path is the most a lab command can do; the page
	# that documents it is what selects it.
	read_environment
	printf '%s\n' "$E2E_KUBECONFIG"
	;;
versions)
	read_environment
	printf 'kubernetes  %s\n' "$E2E_KUBERNETES_VERSION"
	printf 'kind        %s\n' "$(support_kind_version)"
	printf 'operator    %s\n' "$E2E_CONTROLLER_REVISION"
	printf 'executor    %s\n' "$E2E_EXECUTOR_IMAGE"
	printf 'ptah        %s\n' "$E2E_PTAH_VERSION"
	;;
*) lab_usage ;;
esac
