+func TestRetainedAlertingAfterOverdueFix(t *testing.T) {
+ in,err:=phases.Load(phases.Alerting,os.LookupEnv);if err!=nil{t.Fatal(err)}
+ a:=newRetainedAlertingRun(t,in)
+ migrationOverdue:=func(){
+  a.createHeldNamespace()
+  sibling:=alHeldResource(alStalledNamespace,"migration")
+  sibling["spec"].(map[string]any)["suspend"]=true
+  a.check(a.cluster.Client.Create(a.ctx,&unstructured.Unstructured{Object:sibling},client.FieldOwner(harness.FieldOwner),client.FieldValidation("Strict")),"create the unrelated suspended write-control sibling")
+  a.overdueFamily("migration")
+ }
+ for _,row:=range []struct{name string;run func()}{
+ {"monitoring-path-overdue-fix",a.monitoringPath},
+ {"resource-overdue-migration",migrationOverdue},{"lock-release-owed",a.lockReleaseOwed},
+ {"operations-failing",a.operationsFailing},{"plan-store-large",a.planStoreLarge},
+ {"unresolved-view-read-failures",a.viewReadFailures},{"lost-scrape-target",a.lostScrapeTarget},
+ {"certificate-expiry",a.certificateExpiry},{"lost-view",a.lostView},{"upgrade-alerts",a.upgradeAlerts},
+ } {
+  started:=time.Now();passed:=t.Run(row.name,a.scenario(row.run));retainAlertRow(t,row.name,started,passed);if !passed{return}
+ }
+}
