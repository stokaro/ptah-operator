---
/* The catalog of recorded runs.
 *
 * Every run has a page of its own, and a tile here is the link to it. The
 * session below the strip is the first run, playable where it stands. Nothing
 * on this page was written for the page: demo/cmd/record ran each scenario
 * against a kind cluster with the operator installed from its chart, checked
 * the cluster reached the state the scenario claims, and wrote what the
 * commands printed.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RunFrame from '../../components/RunFrame.astro';
import { Runs, playerCatalog, labSummary, checkCount, RecordedPtah, SupportedPtah } from '../../lib/runs.mjs';
import { preview, counts } from '../../../public/demo/transcript.mjs';

const catalog = playerCatalog();
const lab = labSummary();
const checks = checkCount();
const first = Runs[0];
const base = import.meta.env.BASE_URL;
const recordedPtah = RecordedPtah;
const supportedPtah = SupportedPtah;
---

<StarlightPage
	frontmatter={{
		title: 'The operator, recorded',
		description:
			`${Runs.length} runs of the Ptah operator against a real Kubernetes cluster: apply, change, ` +
			'approve, refuse, drift, fail and recover. Read one, or watch it typed.',
		tableOfContents: false,
	}}
>
	{/* The count is read off the recording. A number typed here is a number that
		stops being true the first time a scenario is added. */}
	<p class="ptah-demo-lede">
		{Runs.length} sessions, recorded at the terminal against a four-node kind cluster with the operator
		installed from its chart. Each one is checked while it runs: a recording is published only if every
		condition it claims held on the live cluster. Open one to read the session in full;{' '}
		<strong>Play</strong> types it out where it stands.
	</p>

	<ul class="ptah-demo-lab">
		{lab.map((one) => (
			<li><span class="ptah-demo-lab-label">{one.label}</span><span class="ptah-demo-lab-value">{one.value}</span></li>
		))}
		<li><span class="ptah-demo-lab-label">Checks held</span><span class="ptah-demo-lab-value">{checks}</span></li>
		<li><span class="ptah-demo-lab-label">Runs</span><span class="ptah-demo-lab-value">{Runs.length}</span></li>
	</ul>

	{/* The pairing these runs were recorded against, and whether it is still the
		supported one. Both halves are read rather than typed: a sentence claiming
		they agree keeps reading correctly on the day they stop. */}
	{recordedPtah !== supportedPtah && (
		<p class="ptah-demo-replay">
			These sessions were recorded against Ptah {recordedPtah}. The supported executor is now{' '}
			{supportedPtah}, so read them as evidence about the operator's behaviour rather than as a
			check that these commands still run unchanged today.
		</p>
	)}

	<p class="ptah-demo-replay">
		A replay of a verified run, not a live cluster. Nothing on this page talks to anything.
	</p>

	{first && <RunFrame id={first.id} title={first.title} events={first.events} />}

	{/* A tile is a link to the run's own page, which carries the session in
		full, what it teaches and what was checked while it ran. It is a link and
		not a control, so it works without the player, opens in a new tab the way
		any other link does, and the address it goes to is the one the rail
		offers. */}
	<ul class="tiles not-content">
		{Runs.map((run) => (
			<li class="tile-slot">
				<a class="tile" href={`./${run.id}/`}>
					<span class="tile-head">
						<span class="tile-name">{run.title}</span><span class="tile-tag">{run.tags[0]}</span>
					</span>
					<span class="tile-note">{run.tagline}</span>
					<span class="tile-cmd"><span class="tile-prompt">$</span> {preview(run.events)}</span>
					<span class="tile-meta">
						{counts(run.events)} · {run.checks.length}
						{run.checks.length === 1 ? ' check' : ' checks'}
					</span>
				</a>
			</li>
		))}
	</ul>
</StarlightPage>

<script is:inline set:html={`window.PTAH_RUNS = ${JSON.stringify(catalog)};`} />
<script type="module" src={`${base}demo/player.js`}></script>
