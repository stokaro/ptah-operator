    <div class="lx__workflow" data-lx-workflow data-lx-workflow-model={JSON.stringify(workflowModel)} hidden>
      <p class="lx__title">{workflow.title}</p>
      <p class="lx__summary">{workflow.summary}</p>
      <p class="lx__proposal" data-lx-proposal>
        <span class="lx__mark" data-mark="proposed">{workflow.proposal.label}</span> {workflow.proposal.text}
      </p>
      <ul class="lx__marks" aria-label="What the marks say">
        {
          workflow.marks.map((mark) => (
            <li>
              <span class="lx__mark" data-mark={mark.id}>
                {mark.label}
              </span>{' '}
              {mark.text}
            </li>
          ))
        }
      </ul>

      <div class="lx__bar">
        <p class="lx__count" data-lx-wcount aria-live="polite">
