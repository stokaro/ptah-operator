                      </a>
                    </>
                  )}
                </p>
                <p>
                  <span class="lx__label">Covers</span> {decision.covers}
                </p>
                <p>
                  <span class="lx__label">Does not cover</span> {decision.notCovered}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lx__map" {...part('block', 'workflowRecord')}>
        <p class="lx__map-title">The record a pipeline can keep</p>
        <p>{workflow.recordText}</p>
        <ul class="lx__gaps">
          {
            workflow.record.map((field) => (
              <li data-lx-record={field.id}>
                <strong>{field.label}.</strong> {field.text}
              </li>
            ))
          }
        </ul>
        <div class="lx__inspect">
          <span class="lx__label">Read it from</span>
          {
            workflow.readers.map((reader) => (
              <div class="lx__command">
                <pre><code>{reader.command}</code></pre>
                <p>{reader.says}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lx__map">
        <p class="lx__map-title">What the sequence keeps apart</p>
        <ul class="lx__distinctions">
          {
            workflow.distinctions.map((distinction) => (
              <li>{distinction}</li>
            ))
          }
        </ul>
      </div>

      <p class="lx__later">
        Read more:{' '}
        {
          workflow.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>
  </div>

  <div class="lx__text" data-lx-text>
    {
      views.map((view) => (
        <div class="lx__text-family" data-lx-text-family={view.family.id}>
          <p class="lx__title">{view.scenario.title}</p>
          <p class="lx__summary">{view.scenario.summary}</p>
          {view.textBlocks.map((block) => (
            <div class="lx__text-path" id={textId(block.path.id)} data-lx-text-path={block.path.id}>
              <p>
                <strong>Path: {block.path.title}.</strong> {block.path.summary}
                {block.before && (
                  <>
                    {' '}
                    Stages 1 to {block.before.length} are those of {block.from}: {titles(block.before)}. Then:
                  </>
                )}
              </p>
              <ol class="lx__text-stages" start={block.start}>
                {block.stages.map((stage) => (
                  <li data-lx-text-stage={stage.id}>
                    <p>
                      <strong>{stage.title}.</strong>{' '}
                      <span {...part('stage', 'phase')}>
                        Phase <code>{stage.phase}</code>.
                      </span>
                    </p>
                    <ul>
                      {actorsOf(stage).map((actor) => (
                        <li {...actorPart(actor)}>
                          <strong>{actor.label}:</strong> {actor.text}
                        </li>
                      ))}
                    </ul>
                    <p {...part('stage', 'objects')}>
                      Objects: {stage.objects.map((id) => view.objectById.get(id).label).join(', ')}.
                    </p>
                    {stage.expect && <p {...part('stage', 'expect')}>Expect: {stage.expect}</p>}
                    {stage.inspect.map((step) => (
                      <p {...part('stage', 'inspect')}>
                        <code>{step.command}</code>: {step.says}
                      </p>
                    ))}
                    <p {...part('stage', 'done')}>Done when: {stage.done}</p>
                    {stage.limits && <p {...part('stage', 'limits')}>What it does not prove: {stage.limits}</p>}
                    <p>
                      Read more:{' '}
                      {stage.links.map((link, index) => (
                        <>
                          {index > 0 && ', '}
                          <a href={link.href}>{link.label}</a>
                        </>
                      ))}
                      .
                    </p>
                  </li>
                ))}
              </ol>
              {block.after && block.after.length > 0 && (
                <p>
                  Stages {block.afterStart} to {block.afterStart + block.after.length - 1} are those of {block.from}{' '}
                  again: {titles(block.after)}.
                </p>
              )}
              {block.after && block.after.length === 0 && <p>The path ends here.</p>}
            </div>
          ))}
          <p>
            <strong>The objects, and how they relate.</strong> An owner reference is what the garbage collector
            follows; a name, a UID or a digest is a reference and deletes nothing.
          </p>
          <ul class="lx__text-objects">
            {view.objects.map((object) => (
              <li id={textId(object.id)} data-lx-text-object={object.id}>
                <strong>{object.label}</strong> ({object.kind}). <span {...part('object', 'purpose')}>{object.purpose}</span>{' '}
                <span {...part('object', 'lives')}>{object.lives}</span>{' '}
                <span {...part('object', 'writer')}>Written by: {actorLabel.get(object.writer)}.</span>
                {object.inspect.map((step) => (
                  <p {...part('object', 'inspect')}>
                    <code>{step.command}</code>: {step.says}
                  </p>
                ))}
                <ul>
                  {view.relationsOf(object.id).map((relation) => (
                    <li>
                      {relation.label} <a href={textHref(relation.other)}>{view.objectById.get(relation.other).label}</a>:{' '}
                      {relation.text}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          <p class="lx__later">
            {view.family.notCovered.text}{' '}
            {view.family.notCovered.links.map((link, index) => (
              <>
                {index > 0 && ', '}
                <a href={link.href}>{link.label}</a>
              </>
            ))}
            .
          </p>
        </div>
      ))
    }
    <div class="lx__text-family lx__text-audit" data-lx-text-audit>
      <p class="lx__title">Audit: {audit.title}</p>
      <p class="lx__summary">{audit.textSummary}</p>
      <p {...part('block', 'auditMeasured')}>
        {audit.measured} <a href={audit.measuredLink.href}>{audit.measuredLink.label}</a>.
      </p>
      {
        sourceGroups.map((group) => (
          <div class="lx__text-path" data-lx-text-group={group.id}>
            <p>
              <strong>{group.label}.</strong>
            </p>
            <ul class="lx__text-objects">
              {group.sources.map((source) => (
                <li id={textId(source.id)} data-lx-text-source={source.id}>
                  <p>
                    <strong>{source.label}.</strong> <span {...part('source', 'records')}>{source.records}</span>
                  </p>
                  <p {...part('source', 'establishes')}>Establishes: {source.establishes}</p>
                  <p {...part('source', 'cannot')}>Cannot establish: {source.cannot}</p>
                  <p {...part('source', 'ids')}>Joins the others by: {source.ids.join('; ')}.</p>
                  {source.readers.map((reader) =>
                    reader.command ? (
                      <p {...part('source', 'readers')}>
                        <code>{reader.command}</code>: {reader.says}
                      </p>
                    ) : (
                      <p {...part('source', 'readers')}>
                        {reader.system} {reader.says}
                      </p>
                    ),
                  )}
                  <p {...part('source', 'retention')}>Kept: {source.retention}</p>
                  <ul {...part('source', 'survives')}>
                    {audit.losses.map((loss) => (
                      <li data-lx-text-survives={loss.id}>
                        {loss.label}: {verdictLabel.get(source.survives[loss.id].verdict)},{' '}
                        {basisLabel.get(source.survives[loss.id].basis)}. {source.survives[loss.id].text}
                      </li>
                    ))}
                  </ul>
                  <p>
                    Read more:{' '}
                    {source.links.map((link, index) => (
                      <>
                        {index > 0 && ', '}
                        <a href={link.href}>{link.label}</a>
                      </>
                    ))}
                    .
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="lx__text-path">
        <p {...part('block', 'auditIdentities')}>
          <strong>Identities an audit keeps apart.</strong>
        </p>
        <ul class="lx__text-objects" {...part('block', 'auditIdentities')}>
          {
            audit.identities.map((identity) => (
              <li data-lx-text-identity={identity.id}>
                <strong>{identity.label}.</strong> {identity.text} {identity.note} Recorded in:{' '}
                {identity.recordedIn.map((id, index) => (
                  <>
                    {index > 0 && ', '}
                    <a href={textHref(id)}>{sourceById.get(id).label}</a>
                  </>
                ))}
                .
              </li>
            ))
          }
        </ul>
        {
          audit.distinctions.map((distinction) => (
            <p>{distinction}</p>
          ))
        }
      </div>
      <div class="lx__text-path" {...part('block', 'auditGaps')}>
        <p>
          <strong>Gaps since closed.</strong>
        </p>
        <ul class="lx__text-objects">
          {
            audit.gaps.map((gap) => (
              <li data-lx-text-gap={gap.issue}>
                <a href={issueUrl(gap.issue)}>#{gap.issue}</a>, closed in {gap.version}: <strong>{gap.title}.</strong>{' '}
                {gap.text}
              </li>
            ))
          }
        </ul>
        <p>
          Still deferred, as <a href={audit.deferredLink.href}>{audit.deferredLink.label}</a> record:{' '}
          {
            audit.deferred.map((item, index) => (
              <>
                {index > 0 && ' '}
                <strong>{item.title}.</strong> {item.text}
              </>
            ))
          }
        </p>
      </div>
      <p class="lx__later">
        Read more:{' '}
        {
          audit.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>
    <div class="lx__text-family" data-lx-text-objects>
      <p class="lx__title">Object map: {objectMap.title}</p>
      <p class="lx__summary">{objectMap.textSummary}</p>
      <ul class="lx__text-objects">
        {
          objectMap.types.map((type) => (
            <li data-lx-text-type={type.id}>
              <strong>{type.label}.</strong> {type.text}
            </li>
          ))
        }
      </ul>
      {
        nodeGroups.map((group) => (
          <div class="lx__text-path" data-lx-text-node-group={group.id}>
            <p>
              <strong>{group.label}.</strong>
            </p>
            <ul class="lx__text-objects">
              {group.nodes.map((node) => (
                <li id={textId(node.id)} data-lx-text-node={node.id}>
                  <p>
                    <strong>{node.label}</strong> ({node.kind}
                    <span {...part('node', 'scope')}>; {scopeLabel.get(node.scope)}</span>; {familiesOf(node)}).{' '}
                    <span {...part('node', 'holds')}>{node.holds}</span>
                  </p>
                  <p {...part('node', 'writtenBy')}>Written by: {node.writtenBy}</p>
                  <p {...part('node', 'operator')}>The operator: {node.operator}</p>
                  <p {...part('node', 'change')}>
                    Changes: {changeLabel.get(node.change.verdict)}. {node.change.text}
                  </p>
                  <p {...part('node', 'deletion')}>Deleting it: {node.deletion}</p>
                  <ul>
                    {nodeRelations(node.id).map((relation) => (
                      <li data-lx-text-relation={`${relation.type}:${relation.other}`}>
                        {relation.label} <a href={textHref(relation.other)}>{nodeById.get(relation.other).label}</a>:{' '}
                        {relation.text}
                      </li>
                    ))}
                  </ul>
                  {node.inspect.map((step) => (
                    <p {...part('node', 'inspect')}>
                      <code>{step.command}</code>: {step.says}
                    </p>
                  ))}
                  {node.gap && <p {...part('node', 'gap')}>Gap: {node.gap}</p>}
                  <p>
                    Read more:{' '}
                    {node.links.map((link, index) => (
                      <>
                        {index > 0 && ', '}
                        <a href={link.href}>{link.label}</a>
                      </>
                    ))}
                    .
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      {
        objectMap.distinctions.map((distinction) => (
          <p>{distinction}</p>
        ))
      }
      <p class="lx__later">
        Read more:{' '}
        {
          objectMap.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>
    <div class="lx__text-family" data-lx-text-workflow>
      <p class="lx__title">Composed workflow: {workflow.title}</p>
      <p class="lx__summary">{workflow.textSummary}</p>
      <p data-lx-text-proposal>
        <strong>{workflow.proposal.label}.</strong> {workflow.proposal.text}
      </p>
      <ul class="lx__text-objects">
        {
          workflow.marks.map((mark) => (
            <li data-lx-text-mark={mark.id}>
              <strong>{mark.label}.</strong> {mark.text}
            </li>
          ))
        }
      </ul>
      <div class="lx__text-path" {...part('block', 'workflowPreconditions')}>
        <p>
          <strong>Before the first stage.</strong>
        </p>
        <ul class="lx__text-objects">
          {
            workflow.preconditions.map((precondition) => (
              <li data-lx-text-precondition={precondition.id}>
                <strong>{precondition.title}.</strong> {precondition.text} Objects:{' '}
                {precondition.objects.map((id, index) => (
                  <>
                    {index > 0 && ', '}
                    <a href={textHref(id)}>{nodeById.get(id).label}</a>
                  </>
                ))}
                . Read more:{' '}
                {precondition.links.map((link, index) => (
                  <>
                    {index > 0 && ', '}
                    <a href={link.href}>{link.label}</a>
                  </>
                ))}
                .
              </li>
            ))
          }
        </ul>
      </div>
      <ol class="lx__text-stages">
        {
          workflow.stages.map((stage, index) => (
            <li id={textId(stage.id)} data-lx-text-wstage={stage.id}>
              <p>
                <strong>{stage.title}.</strong> {stageFamily(stage.family)}.{' '}
                <span {...part('wstage', 'goal')}>{stage.goal}</span>
              </p>
              <p {...part('wstage', 'person')}>You: {stage.person}</p>
              {stage.inspect.map((step) =>
                step.command ? (
                  <p {...part('wstage', 'inspect')}>
                    <code>{step.command}</code>: {step.says}
                  </p>
                ) : (
                  <p {...part('wstage', 'inspect')}>
                    {step.system} {step.says}
                  </p>
                ),
              )}
              <p data-lx-text-wpart="operator" {...part('wstage', 'operator')}>
                The operator, {markLabel.get('shipped').toLowerCase()}: {stage.operator}
              </p>
              {stage.decision && (
                <p data-lx-text-wpart="decision" {...part('wstage', 'decision')}>
                  Decision: <a href={textHref(stage.decision)}>{decisionById.get(stage.decision).label}</a>.{' '}
                  {stage.decisionText}
                </p>
              )}
              <p data-lx-text-wpart="gate" {...part('wstage', 'gate')}>
                Moves on when, {markLabel.get('proposed').toLowerCase()}: {stage.gate}
              </p>
              <p {...part('wstage', 'done')}>Done when: {stage.done}</p>
              {stage.limits && <p {...part('wstage', 'limits')}>What it does not prove: {stage.limits}</p>}
              <p>What can stop it:</p>
              <ul>
                {stage.outcomes.map((one) => (
                  <li data-lx-text-wstop={one.outcome}>
                    <strong>{outcomeById.get(one.outcome).label}.</strong> {one.text} Clears it: {one.recovery}{' '}
                    {heldAfter(index) ? `Held until it is cleared: ${heldAfter(index)}.` : 'No stage follows it.'}
                    {one.journey && (
                      <>
                        {' '}
                        The change journey walks it as{' '}
                        <a href={textHref(one.journey.path)}>{pathOf(one.journey).label}</a>.
                      </>
                    )}
                  </li>
                ))}
              </ul>
              <p {...part('wstage', 'objects')}>
                Objects:{' '}
                {stage.objects.map((id, at) => (
                  <>
                    {at > 0 && ', '}
                    <a href={textHref(id)}>{nodeById.get(id).label}</a>
                  </>
                ))}
                .
              </p>
              <p>
                Read more:{' '}
                {stage.links.map((link, at) => (
                  <>
                    {at > 0 && ', '}
                    <a href={link.href}>{link.label}</a>
                  </>
                ))}
                .
              </p>
            </li>
          ))
        }
      </ol>
      <div class="lx__text-path">
        <p>
          <strong>What can stop a stage.</strong>
        </p>
        <ul class="lx__text-objects">
          {
            workflow.outcomes.map((outcome) => (
              <li data-lx-text-woutcome={outcome.id}>
                <strong>{outcome.label}.</strong> {outcome.text}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lx__text-path" {...part('block', 'workflowDecisions')}>
        <p>
          <strong>What each decision covers.</strong>
        </p>
        <ul class="lx__text-objects">
          {
            workflow.decisions.map((decision) => (
              <li id={textId(decision.id)} data-lx-text-decision={decision.id}>
                <strong>{decision.label}.</strong> Covers: {decision.covers} Does not cover: {decision.notCovered}
                {decision.node && (
                  <>
                    {' '}
                    In the object map: <a href={textHref(decision.node)}>{nodeById.get(decision.node).label}</a>.
                  </>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lx__text-path" {...part('block', 'workflowRecord')}>
        <p>
          <strong>The record a pipeline can keep.</strong> {workflow.recordText}
        </p>
        <ul class="lx__text-objects">
          {
            workflow.record.map((field) => (
              <li data-lx-text-record={field.id}>
                <strong>{field.label}.</strong> {field.text}
              </li>
            ))
          }
        </ul>
        {
          workflow.readers.map((reader) => (
            <p>
              <code>{reader.command}</code>: {reader.says}
            </p>
          ))
        }
      </div>
      {
        workflow.distinctions.map((distinction) => (
          <p>{distinction}</p>
        ))
      }
      <p class="lx__later">
        Read more:{' '}
        {
          workflow.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>
  </div>

  <details class="lx__glossary" data-lx-glossary>
    <summary class="lx__glossary-title">Terms the explorer uses</summary>
    <dl class="lx__terms">
      {
        glossary.map((entry) => (
          <div class="lx__term" id={termId(entry.id)} data-lx-term={entry.id}>
            <dt>{entry.term}</dt>
            <dd>
              {entry.text} Read more:{' '}
              {entry.links.map((link, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
              .
            </dd>
          </div>
        ))
      }
    </dl>
  </details>
</section>

<style>
  .lx {
    --lx-gap: 0.75rem;
    container-type: inline-size;
    margin-block: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    background: var(--ptah-surface);
    line-height: 1.5;
    font-size: 0.9375rem;
    /* A reason such as ConvergedAfterUnknownOutcome is one word wider than a
     * 320px column; it breaks rather than widening the explorer. */
    overflow-wrap: break-word;
  }

  .lx [hidden] {
    display: none !important;
  }

  .lx p,
  .lx ul,
  .lx ol {
    margin: 0;
  }

  .lx :is(p, ul, ol, div) + :is(p, ul, ol, div) {
    margin-top: var(--lx-gap);
  }

  .lx__eyebrow,
  .lx__label,
  .lx__map-title {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lx__label {
    margin-right: 0.35rem;
  }

  /* The depth choice: radio buttons, so it works without the script, drawn
   * like the view bar. Each note says what its depth adds, and only the
   * chosen one shows. */
  .lx__depth {
    margin: 0.5rem 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .lx__depth legend {
    float: left;
    margin-block: 0.3rem;
    padding: 0;
  }

  .lx__depth-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .lx__depth-option {
    position: relative;
  }

  .lx__depth-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .lx__depth-option span {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
  }

  .lx__depth-option input:checked + span {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .lx__depth-option input:focus-visible + span {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .lx__depth-note {
    clear: left;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .lx [data-lx-depth-note] {
    display: none;
  }

  .lx:has([data-lx-depth-choice][value='overview']:checked) [data-lx-depth-note='overview'],
  .lx:has([data-lx-depth-choice][value='product']:checked) [data-lx-depth-note='product'],
  .lx:has([data-lx-depth-choice][value='implementation']:checked) [data-lx-depth-note='implementation'] {
    display: block;
  }

  /* A part deeper than the depth chosen is not shown, in the interactive
   * view and in the text alike. */
  .lx:has([data-lx-depth-choice][value='overview']:checked) :is([data-lx-depth='product'], [data-lx-depth='implementation']),
  .lx:has([data-lx-depth-choice][value='product']:checked) [data-lx-depth='implementation'] {
    display: none;
  }

  .lx__title {
    color: var(--sl-color-white);
    font-size: var(--sl-text-h3);
    font-weight: 600;
  }

  .lx__summary,
  .lx__hint,
  .lx__later {
    color: var(--sl-color-gray-2);
  }

  .lx code {
    overflow-wrap: break-word;
    font-size: var(--sl-text-code-sm);
  }

  /* The root is not-content, so Starlight's prose rules stay out of the
   * layout; the links still read as the page's links. */
  .lx a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lx__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .lx__count {
    color: var(--sl-color-gray-2);
  }

  .lx__nav {
    display: flex;
    gap: 0.5rem;
  }

  .lx .lx__nav,
  .lx .lx__steps {
    margin-top: 0;
  }

  .lx__steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.375rem;
    padding: 0;
    list-style: none;
    margin-top: var(--lx-gap) !important;
  }

  .lx__steps li {
    margin: 0 !important;
  }

  .lx__button,
  .lx__step,
  .lx__chip,
  .lx__node {
    font: inherit;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    cursor: pointer;
  }

  .lx__button {
    padding: 0.35rem 0.8rem;
  }

  .lx__button:disabled {
    color: var(--sl-color-gray-3);
    cursor: default;
  }

  .lx__step {
    display: flex;
    width: 100%;
    height: 100%;
    gap: 0.4rem;
    align-items: flex-start;
    padding: 0.4rem 0.5rem;
    text-align: left;
    font-size: var(--sl-text-xs);
    line-height: 1.3;
  }

  .lx__step-n,
  .lx__panel-n {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-4);
    font-variant-numeric: tabular-nums;
  }

  .lx__step[aria-current='step'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .lx__step[aria-current='step'] .lx__step-n,
  .lx__panel-n {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }

  .lx__step[data-done] .lx__step-n {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .lx__panel,
  .lx__object {
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .lx__panel-head > * {
    margin-top: 0 !important;
  }

  .lx__panel-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h4);
    font-weight: 600;
  }

  .lx__actors {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .lx__actor {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0 !important;
    padding: 0.5rem 0.625rem;
    border-left: 3px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }

  .lx__actor[data-lead] {
    border-left-color: var(--sl-color-accent);
  }

  .lx__actor-name {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .lx__lead {
    display: block;
    color: var(--sl-color-accent);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }

  .lx__involved,
  .lx__goto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .lx__chip {
    padding: 0.15rem 0.55rem;
    font-size: var(--sl-text-xs);
  }

  .lx__chip[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .lx__command {
    margin-top: 0.375rem !important;
  }

  .lx__command pre {
    margin: 0;
    padding: 0.5rem 0.625rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-inline-code);
    font-size: var(--sl-text-code-sm);
    line-height: 1.5;
  }

  /* A command keeps its lines as typed, so a flag never breaks at its hyphen;
   * a long one scrolls inside its own box rather than widening the page. */
  .lx__command pre code {
    white-space: pre;
    overflow-wrap: normal;
  }

  .lx__command p {
    margin-top: 0.25rem !important;
    color: var(--sl-color-gray-2);
  }

  .lx__limits {
    padding-left: 0.625rem;
    border-left: 3px solid var(--ptah-amber);
  }

  .lx__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .lx__map {
    margin-top: 1.25rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__nodes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .lx__nodes li {
    margin: 0 !important;
  }

  .lx__node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    width: 100%;
    height: 100%;
    padding: 0.5rem 0.625rem;
    text-align: left;
    border-width: 2px;
    border-color: var(--sl-color-hairline);
  }

  /* A part such as Acknowledgment is wider than a node in two columns of
   * a 320px screen, so the map takes one column there (below). Should a part
   * still not fit, it breaks rather than reaching past the node. */
  .lx__node-label {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .lx__node-kind {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .lx__node-rel {
    color: var(--sl-color-accent);
    font-size: var(--sl-text-xs);
  }

  .lx__node[data-in-stage] {
    background: var(--sl-color-accent-low);
  }

  .lx__node[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    border-style: solid;
  }

  /* A related node carries its relation's line style, the one the legend
   * draws, so the type reads without color as well. */
  .lx__node[data-related='owns'] {
    border-color: var(--sl-color-gray-2);
    border-style: solid;
  }
  .lx__node[data-related='references'] {
    border-color: var(--sl-color-gray-2);
    border-style: dashed;
  }
  .lx__node[data-related='contains'] {
    border-color: var(--sl-color-gray-2);
    border-style: double;
    border-width: 3px;
  }
  .lx__node[data-related='holds'] {
    border-color: var(--ptah-amber);
    border-style: dotted;
  }
  .lx__node[data-related='delivers'] {
    border-color: var(--ptah-green);
    border-style: dashed;
  }
  .lx__node[data-related='executes'] {
    border-color: var(--ptah-amber);
    border-style: solid;
    border-width: 3px;
  }

  .lx__legend,
  .lx__relations {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }

  .lx__relations {
    font-size: inherit;
  }

  .lx__legend li,
  .lx__relations li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    margin: 0 !important;
  }

  .lx__legend strong,
  .lx__relations strong {
    color: var(--sl-color-white);
  }

  .lx__swatch {
    display: block;
    height: 0;
    border-top: 2px solid var(--sl-color-gray-2);
    transform: translateY(-0.25em);
  }

  [data-type='references'] > .lx__swatch {
    border-top-style: dashed;
  }
  [data-type='contains'] > .lx__swatch {
    border-top: 4px double var(--sl-color-gray-2);
  }
  [data-type='holds'] > .lx__swatch {
    border-top: 3px dotted var(--ptah-amber);
  }
  [data-type='delivers'] > .lx__swatch {
    border-top: 2px dashed var(--ptah-green);
  }
  [data-type='executes'] > .lx__swatch {
    border-top: 3px solid var(--ptah-amber);
  }

  /* A hint sits under its object on hover or keyboard focus, inside the
   * object's own width, so it never widens a phone-width column. It touches
   * the object, so a pointer can move onto it and read it without it going
   * away. A device that cannot hover shows none: a tap opens the panel, which
   * says more, and a hint left behind by a tap would cover the next object.
   * For the same reason a focus shows it only where the browser marks focus,
   * which a click or a tap does not. Escape hides it until the pointer or the
   * focus leaves. */
  .lx__has-tip {
    position: relative;
  }

  .lx__tip {
    display: none;
    position: absolute;
    z-index: 3;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: var(--sl-text-xs);
  }

  @media (hover: hover) {
    .lx__has-tip:hover > .lx__tip {
      display: block;
    }
  }

  .lx__node:focus-visible + .lx__tip {
    display: block;
  }

  .lx__has-tip[data-lx-tip-dismissed] > .lx__tip {
    display: none;
  }

  .lx__glossary {
    margin-top: 1rem;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__glossary-title {
    cursor: pointer;
    font-weight: 600;
  }

  .lx__glossary-title:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .lx__terms {
    margin: var(--lx-gap) 0 0;
  }

  .lx__term dt {
    font-weight: 600;
  }

  .lx__term dd {
    margin: 0;
  }

  /* A chip that is a link still reads as a chip. */
  .lx a.lx__chip {
    display: inline-block;
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .lx a.lx__chip[aria-current='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .lx__text-stages,
  .lx__text-objects {
    padding-left: 1.25rem;
  }

  .lx__text li + li {
    margin-top: 0.75rem;
  }

  .lx__text ul {
    padding-left: 1.1rem;
  }

  .lx__text li li + li {
    margin-top: 0.25rem;
  }

  .lx__text p + p {
    margin-top: 0.25rem;
  }

  .lx__later {
    margin-top: 1rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
  }

  /* The path bar: one button per path, the current one pressed. */
  .lx__paths {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .lx__paths .lx__label {
    margin-right: 0.15rem;
  }

  .lx__path {
    padding: 0.25rem 0.7rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    cursor: pointer;
  }

  .lx__path[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .lx__path-summary {
    color: var(--sl-color-gray-2);
  }

  .lx__path-summary strong {
    color: var(--sl-color-white);
  }

  /* A stage only another path walks: its own line style, so the turn reads
   * without color as well. */
  .lx__step[data-branch] {
    border-style: dashed;
    border-color: var(--ptah-amber);
  }

  .lx__step[data-branch][aria-current='step'] {
    border-style: solid;
    border-color: var(--sl-color-accent);
  }

  .lx__branch-tag {
    padding: 0 0.45rem;
    border: 1px dashed var(--ptah-amber);
    border-radius: 2px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }

  .lx__turn {
    padding: 0.5rem 0.625rem;
    border: 1px dashed var(--ptah-amber);
    background: var(--sl-color-bg);
  }

  .lx__turn-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.375rem;
    margin-top: 0.375rem !important;
  }

  .lx__turn-option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.4rem 0.6rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    text-align: left;
    color: var(--sl-color-text);
    background: var(--ptah-surface);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    cursor: pointer;
  }

  .lx__turn-option strong {
    color: var(--sl-color-white);
  }

  .lx__turn-option span {
    color: var(--sl-color-gray-2);
  }

  .lx__turn-option[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .lx__text-path + .lx__text-path {
    margin-top: 1rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__path:focus-visible,
  .lx__turn-option:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* The family bar switches the whole view below it, so it stands apart
   * from the path bar inside that view. */
  .lx__families {
    padding-bottom: var(--lx-gap);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .lx__text-family + .lx__text-family {
    margin-top: 1.5rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  /* The view bar switches everything below it, the family bar included. */
  .lx__views {
    padding-bottom: var(--lx-gap);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .lx__measured,
  .lx__note,
  .lx__deferred {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
  }

  .lx__basis,
  .lx__verdict {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .lx__source[aria-pressed='true'] {
    background: var(--sl-color-accent-low);
  }

  /* After a loss, each source carries its verdict in a line style of its own
   * as well as in words, so it reads without color. These come after the
   * pressed rule, so a selected source keeps its verdict's border. */
  .lx__source[data-verdict='kept'] {
    border-color: var(--ptah-green);
    border-style: solid;
  }
  .lx__source[data-verdict='gone'] {
    border-color: var(--sl-color-gray-3);
    border-style: dashed;
  }
  .lx__source[data-verdict='outside'] {
    border-color: var(--ptah-amber);
    border-style: dotted;
  }

  .lx__ids,
  .lx__distinctions,
  .lx__gaps {
    padding-left: 1.1rem;
  }

  .lx__ids li + li,
  .lx__distinctions li + li,
  .lx__gaps li + li {
    margin-top: 0.25rem;
  }

  .lx__system {
    padding: 0.5rem 0.625rem;
    border: 1px dashed var(--sl-color-hairline);
  }

  .lx__survives,
  .lx__identities {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }

  .lx__survives li {
    display: grid;
    grid-template-columns: 9rem auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    margin: 0 !important;
    padding: 0.25rem 0.5rem;
    border-left: 3px solid var(--sl-color-hairline);
  }
  .lx__survives li[data-verdict='kept'] {
    border-left-color: var(--ptah-green);
  }
  .lx__survives li[data-verdict='gone'] {
    border-left-color: var(--sl-color-gray-3);
    border-left-style: dashed;
  }
  .lx__survives li[data-verdict='outside'] {
    border-left-color: var(--ptah-amber);
    border-left-style: dotted;
  }
  .lx__survives li[data-current] {
    background: var(--sl-color-accent-low);
  }

  .lx__verdict-tag {
    padding: 0 0.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .lx__identities li {
    margin: 0 !important;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }

  .lx__identities li > * + * {
    margin-top: 0.375rem;
  }

  .lx__gap-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .lx__mark {
    padding: 0 0.4rem;
    border: 1px solid var(--ptah-green);
    border-radius: 2px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .lx__mark[data-mark='proposed'] {
    border-style: dashed;
    border-color: var(--ptah-amber);
  }

  .lx__proposal {
    padding: 0.5rem 0.625rem;
    border: 1px dashed var(--ptah-amber);
    background: var(--sl-color-bg);
  }

  .lx__marks {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
    color: var(--sl-color-gray-2);
  }

  .lx__marks li {
    margin: 0 !important;
  }

  .lx__wsteps {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .lx__wsteps .lx__step-t {
    display: grid;
    gap: 0.15rem;
  }

  .lx__step-mark {
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }

  .lx__step-mark:empty {
    display: none;
  }

  .lx__step[data-state='held'] {
    border-style: dashed;
    color: var(--sl-color-gray-3);
  }

  .lx__step[data-state='stopped'] {
    border-color: var(--ptah-amber);
    background: var(--sl-color-bg);
  }

  .lx__step[data-state='stopped'] .lx__step-n {
    border-width: 2px;
    border-color: var(--ptah-amber);
    background: none;
    color: inherit;
  }

  .lx__step[data-state='done'] .lx__step-n {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .lx__wstatus {
    padding: 0.4rem 0.625rem;
    border-left: 3px solid var(--ptah-amber);
  }

  .lx__wstop {
    padding: 0.5rem 0.625rem;
    border-left: 3px solid var(--ptah-amber);
    background: var(--sl-color-bg);
  }

  .lx__wstop > * + * {
    margin-top: 0.375rem;
  }

  /* Once the script runs, the interactive view replaces the text. */
  .lx[data-lx-ready] .lx__text {
    display: none;
  }

  @container (max-width: 34rem) {
    .lx__step {
      justify-content: center;
      padding: 0.4rem 0.2rem;
    }
    .lx__step-t,
    .lx__wsteps .lx__step-t {
      display: none;
    }
    .lx__actor {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
    .lx__lead {
      display: inline;
      margin-left: 0.4rem;
    }
    .lx__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lx__survives li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .lx__survives li > :last-child {
      grid-column: 1 / -1;
    }
  }

  @container (min-width: 34.01rem) and (max-width: 44rem) {
    .lx__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (max-width: 18rem) {
    .lx__nodes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lx__panel:not([hidden]),
    .lx__object:not([hidden]) {
      animation: lx-in 160ms ease-out;
    }
    @keyframes lx-in {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
    }
  }

  @media print {
    .lx__app {
      display: none !important;
    }
    .lx[data-lx-ready] .lx__text {
      display: block;
    }
  }
</style>

<script>
  type PathModel = {
    id: string;
    walk: string[];
    turnsAfter: string | null;
    first: string | null;
    parent: string | null;
    own: string[];
  };
  type Model = {
    family: string;
    stages: { id: string; objects: string[] }[];
    paths: PathModel[];
    defaultPath: string;
    relations: { from: string; to: string; type: string }[];
    types: Record<string, { label: string; inverse: string; text: string }>;
  };
  type Family = {
    id: string;
    view: HTMLElement;
    owns: (stage: string) => boolean;
    hasPath: (path: string) => boolean;
    hasObject: (object: string) => boolean;
    reset: () => void;
    restore: (params: URLSearchParams) => void;
    state: () => { path: string | null; stage: string; object: string | null };
    render: (write?: boolean) => void;
  };
  type AuditModel = {
    verdicts: Record<string, string>;
    sources: Record<string, Record<string, string>>;
  };
  type Audit = {
    view: HTMLElement;
    hasSource: (source: string) => boolean;
    hasLoss: (loss: string) => boolean;
    reset: () => void;
    restore: (params: URLSearchParams) => void;
    state: () => { loss: string | null; source: string | null };
    render: (write?: boolean) => void;
  };
  type ObjectMapModel = {
    relations: { from: string; to: string; type: string }[];
    types: Record<string, { label: string; inverse: string; text: string }>;
  };
  type ObjectMap = {
    view: HTMLElement;
    hasNode: (node: string) => boolean;
    reset: () => void;
    restore: (params: URLSearchParams) => void;
    state: () => { node: string | null };
    render: (write?: boolean) => void;
  };
  type WorkflowModel = {
    stages: { id: string; outcomes: string[] }[];
    outcomes: Record<string, string>;
  };
  type Workflow = {
    view: HTMLElement;
    hasStage: (stage: string) => boolean;
    reset: () => void;
    restore: (params: URLSearchParams) => void;
    state: () => { step: string | null; outcome: string | null };
    render: (write?: boolean) => void;
  };

  const FAMILY_PARAM = 'lx-family';
  const STAGE_PARAM = 'lx-stage';
  const OBJECT_PARAM = 'lx-object';
  const PATH_PARAM = 'lx-path';
  const VIEW_PARAM = 'lx-view';
  const LOSS_PARAM = 'lx-loss';
  const SOURCE_PARAM = 'lx-source';
  const NODE_PARAM = 'lx-node';
  const STEP_PARAM = 'lx-step';
  const OUTCOME_PARAM = 'lx-outcome';
  const DEPTH_PARAM = 'lx-depth';
  const JOURNEY = 'journey';
  const AUDIT = 'audit';
  const OBJECTS = 'objects';
  const WORKFLOW = 'workflow';
  const JOURNEY_PARAMS = [FAMILY_PARAM, PATH_PARAM, STAGE_PARAM, OBJECT_PARAM];
  const AUDIT_PARAMS = [LOSS_PARAM, SOURCE_PARAM];
  const OBJECT_MAP_PARAMS = [NODE_PARAM];
  const WORKFLOW_PARAMS = [STEP_PARAM, OUTCOME_PARAM];

  // A link is followed in place on a plain click with the main button, and
  // the page is not loaded again. A click with a modifier or another button
  // is the browser's: a new tab or window opens the address the link names.
  const inPlace = (event: MouseEvent, element: Element) => {
    if (!(element instanceof HTMLAnchorElement)) return true;
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
    event.preventDefault();
    return true;
  };

  const reveal = (element: HTMLElement) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    element.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
  };

  // One family's view: the path, the stage and the selection a reader chose
  // in it, and the controls that move them. `changed` writes the address, and
  // is called only once the reader chose something.
  function family(view: HTMLElement, changed: () => void): Family | null {
    const model: Model = JSON.parse(view.dataset.lxModel || '{}');
    if (!model.stages?.length || !model.paths?.length) return null;

    const stageObjects = new Map(model.stages.map((stage) => [stage.id, stage.objects]));
    const pathById = new Map(model.paths.map((path) => [path.id, path]));
    const lists = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-steps]')].map((list) => [list.dataset.lxSteps!, list]),
    );
    const stepsOf = (id: string) => [...(lists.get(id)?.querySelectorAll<HTMLButtonElement>('[data-lx-step]') ?? [])];
    const allSteps = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-step]')];
    const stagePanels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-stage-panel]')].map((panel) => [panel.dataset.lxStagePanel, panel]),
    );
    const pathButtons = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-path]')];
    const summaries = [...view.querySelectorAll<HTMLElement>('[data-lx-path-summary]')];
    const nodes = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-object]')];
    const objectPanels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-object-panel]')].map((panel) => [panel.dataset.lxObjectPanel, panel]),
    );
    const count = view.querySelector<HTMLElement>('[data-lx-count]');
    const prev = view.querySelector<HTMLButtonElement>('[data-lx-prev]');
    const next = view.querySelector<HTMLButtonElement>('[data-lx-next]');

    let pathId = model.defaultPath;
    let stageIndex = 0;
    let selected: string | null = null;

    const walk = () => pathById.get(pathId)!.walk;
    const currentStage = () => walk()[stageIndex];
    // The path a stage belongs to when the current one does not walk it: the
    // default if it walks it, else the path whose own stage it is, else any
    // path that walks it.
    const pathWalking = (stage: string) =>
      pathById.get(model.defaultPath)!.walk.includes(stage)
        ? model.defaultPath
        : (model.paths.find((path) => path.own.includes(stage))?.id ??
          model.paths.find((path) => path.walk.includes(stage))?.id ??
          null);

    // The relation between the selected object and another, read from the
    // selected end. Two relations between one pair (a reference and an owner
    // reference) show ownership, the one the garbage collector acts on.
    const relationTo = (other: string) => {
      const found = model.relations.filter(
        (relation) =>
          (relation.from === selected && relation.to === other) || (relation.to === selected && relation.from === other),
      );
      if (found.length === 0) return null;
      const relation = found.find((one) => one.type === 'owns') ?? found[0];
      const type = model.types[relation.type];
      return { type: relation.type, label: relation.from === selected ? type.label : type.inverse, text: type.text };
    };

    // An object's hint is its own, or how it relates to the one selected.
    const hintFor = (node: HTMLElement, relation: { label: string; text: string } | null) => {
      const tip = node.parentElement?.querySelector<HTMLElement>('[data-lx-tip]');
      if (tip) tip.textContent = relation ? `${relation.label}: ${relation.text}` : (tip.dataset.lxTip ?? '');
    };

    // The URL changes only after the reader chose something, so a page that
    // was merely opened keeps the address it was opened at.
    const render = (write = true) => {
      const stage = currentStage();
      const steps = stepsOf(pathId);
      for (const [id, list] of lists) list.hidden = id !== pathId;
      for (const step of allSteps) {
        step.removeAttribute('aria-current');
        delete step.dataset.done;
      }
      steps.forEach((step, index) => {
        const current = index === stageIndex;
        if (current) step.setAttribute('aria-current', 'step');
        step.tabIndex = current ? 0 : -1;
        if (index < stageIndex) step.dataset.done = '';
      });
      for (const [id, panel] of stagePanels) {
        panel.hidden = id !== stage;
        if (id !== stage) continue;
        const number = panel.querySelector<HTMLElement>('[data-lx-panel-n]');
        if (number) number.textContent = String(stageIndex + 1);
        const following = walk()[stageIndex + 1] ?? null;
        for (const option of panel.querySelectorAll<HTMLElement>('[data-lx-choose]')) {
          option.setAttribute('aria-pressed', String(option.dataset.lxThen === following));
        }
      }
      const title = steps[stageIndex]?.querySelector('.lx__step-t')?.textContent ?? '';
      if (count) count.textContent = `Stage ${stageIndex + 1} of ${walk().length}: ${title}`;
      if (prev) prev.disabled = stageIndex === 0;
      if (next) next.disabled = stageIndex === walk().length - 1;
      for (const button of pathButtons) button.setAttribute('aria-pressed', String(button.dataset.lxPath === pathId));
      for (const summary of summaries) summary.hidden = summary.dataset.lxPathSummary !== pathId;

      const inStage = stageObjects.get(stage) ?? [];
      for (const node of nodes) {
        const id = node.dataset.lxObject!;
        if (inStage.includes(id)) node.dataset.inStage = '';
        else delete node.dataset.inStage;
        node.setAttribute('aria-pressed', String(id === selected));
        const relation = selected && id !== selected ? relationTo(id) : null;
        const badge = node.querySelector<HTMLElement>('[data-lx-rel]');
        hintFor(node, relation);
        if (relation) {
          node.dataset.related = relation.type;
          if (badge) badge.textContent = relation.label;
        } else {
          delete node.dataset.related;
          if (badge) badge.textContent = id === selected ? 'Selected' : '';
        }
      }
      for (const chip of view.querySelectorAll<HTMLElement>('.lx__involved [data-lx-select]')) {
        if (chip.dataset.lxSelect === selected) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      }
      for (const [id, panel] of objectPanels) panel.hidden = id !== selected;
      if (write) changed();
    };

    const focusStep = () => stepsOf(pathId)[stageIndex]?.focus();

    const goTo = (index: number, focus = false) => {
      stageIndex = Math.max(0, Math.min(walk().length - 1, index));
      render();
      if (focus) focusStep();
    };

    // Switch to a path at a stage it walks, or at its first stage if it walks
    // none by that id.
    const setPath = (id: string, stage: string | null, focus = false) => {
      if (!pathById.has(id)) return;
      pathId = id;
      stageIndex = Math.max(0, stage ? walk().indexOf(stage) : 0);
      render();
      if (focus) focusStep();
    };

    // A path chosen from the bar keeps the stage when the new path walks it
    // too. Otherwise it opens where the two differ: going back to a path the
    // current one turned off, directly or through another, at the stage where
    // it left that path; going anywhere else, at the new path's first own
    // stage.
    const choosePath = (id: string) => {
      const target = pathById.get(id);
      if (!target || id === pathId) return;
      const stage = currentStage();
      if (target.walk.includes(stage)) {
        setPath(id, stage);
        return;
      }
      let from = pathById.get(pathId);
      for (let hops = 0; from?.parent && hops < model.paths.length; hops += 1) {
        if (from.parent === id) {
          setPath(id, from.turnsAfter);
          return;
        }
        from = pathById.get(from.parent);
      }
      setPath(id, target.first);
    };

    const select = (id: string | null, scroll = false) => {
      selected = id && objectPanels.has(id) ? id : null;
      render();
      if (scroll && selected) reveal(objectPanels.get(selected)!);
    };

    for (const step of allSteps) {
      step.addEventListener('click', () => {
        const index = stepsOf(pathId).indexOf(step);
        if (index >= 0) goTo(index);
      });
      step.addEventListener('keydown', (event) => {
        const moves: Record<string, number> = {
          ArrowRight: stageIndex + 1,
          ArrowDown: stageIndex + 1,
          ArrowLeft: stageIndex - 1,
          ArrowUp: stageIndex - 1,
          Home: 0,
          End: walk().length - 1,
        };
        if (!(event.key in moves)) return;
        event.preventDefault();
        goTo(moves[event.key], true);
      });
    }
    prev?.addEventListener('click', () => goTo(stageIndex - 1));
    next?.addEventListener('click', () => goTo(stageIndex + 1));
    for (const button of pathButtons) button.addEventListener('click', () => choosePath(button.dataset.lxPath!));

    for (const node of nodes) {
      node.addEventListener('click', () => {
        const id = node.dataset.lxObject!;
        select(selected === id ? null : id);
      });
    }
    view.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const chip = target.closest<HTMLElement>('[data-lx-select]');
      if (chip && inPlace(event, chip)) select(chip.dataset.lxSelect!, true);
      // A turn goes on along the current path when that path takes it, and
      // switches to the path that does otherwise. Focus moves to the stage it
      // reached, since the panel that held the choice is now hidden.
      const choice = target.closest<HTMLElement>('[data-lx-choose]');
      if (choice) {
        const following = choice.dataset.lxThen!;
        if (walk()[stageIndex + 1] === following) goTo(stageIndex + 1, true);
        else setPath(choice.dataset.lxChoose!, following, true);
      }
      const goto = target.closest<HTMLElement>('[data-lx-goto]');
      if (goto && inPlace(event, goto)) {
        const stage = goto.dataset.lxGoto!;
        if (walk().includes(stage)) goTo(walk().indexOf(stage));
        else setPath(pathWalking(stage) ?? model.defaultPath, stage);
        stepsOf(pathId)[stageIndex]?.scrollIntoView({ block: 'nearest' });
      }
    });

    const reset = () => {
      pathId = model.defaultPath;
      stageIndex = 0;
      selected = null;
    };

    return {
      id: model.family,
      view,
      owns: (stage) => stageObjects.has(stage),
      hasPath: (path) => pathById.has(path),
      hasObject: (object) => objectPanels.has(object),
      reset,
      // A link restores what it names of this family and keeps the default
      // for the rest, so a value that belongs to another family is ignored. A
      // link that names a stage of another path and no path opens that
      // stage's path.
      restore: (params) => {
        reset();
        const wantedStage = params.get(STAGE_PARAM) ?? '';
        const wantedPath = params.get(PATH_PARAM);
        if (wantedPath && pathById.has(wantedPath)) pathId = wantedPath;
        else if (wantedStage) pathId = pathWalking(wantedStage) ?? model.defaultPath;
        const wanted = walk().indexOf(wantedStage);
        if (wanted >= 0) stageIndex = wanted;
        const object = params.get(OBJECT_PARAM);
        if (object && objectPanels.has(object)) selected = object;
      },
      state: () => ({ path: pathId === model.defaultPath ? null : pathId, stage: currentStage(), object: selected }),
      render,
    };
  }

  // The audit view: the loss a reader chose, which marks what each source
  // keeps after it, and the source whose detail is open. Choosing the pressed
  // loss or the selected source again clears it.
  function auditView(view: HTMLElement, changed: () => void): Audit | null {
    const model: AuditModel = JSON.parse(view.dataset.lxAuditModel || '{}');
    if (!model.sources || !model.verdicts) return null;

    const lossButtons = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-loss]')];
    const summaries = [...view.querySelectorAll<HTMLElement>('[data-lx-loss-summary]')];
    const nodes = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-source]')];
    const chips = [...view.querySelectorAll<HTMLAnchorElement>('[data-lx-source-select]')];
    const panels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-source-panel]')].map((panel) => [panel.dataset.lxSourcePanel!, panel]),
    );
    const hint = view.querySelector<HTMLElement>('[data-lx-source-hint]');
    const losses = new Set(lossButtons.map((button) => button.dataset.lxLoss!));

    let loss: string | null = null;
    let selected: string | null = null;

    const render = (write = true) => {
      for (const button of lossButtons) button.setAttribute('aria-pressed', String(button.dataset.lxLoss === loss));
      for (const summary of summaries) summary.hidden = (summary.dataset.lxLossSummary || null) !== loss;
      for (const node of nodes) {
        const id = node.dataset.lxSource!;
        node.setAttribute('aria-pressed', String(id === selected));
        const verdict = loss ? model.sources[id]?.[loss] : undefined;
        if (verdict) node.dataset.verdict = verdict;
        else delete node.dataset.verdict;
        const badge = node.querySelector<HTMLElement>('[data-lx-verdict]');
        if (badge) badge.textContent = verdict ? (model.verdicts[verdict] ?? '') : '';
      }
      for (const [id, panel] of panels) {
        panel.hidden = id !== selected;
        for (const row of panel.querySelectorAll<HTMLElement>('[data-lx-survives]')) {
          if (row.dataset.lxSurvives === loss) row.dataset.current = '';
          else delete row.dataset.current;
        }
      }
      if (hint) hint.hidden = selected !== null;
      for (const chip of chips) {
        if (chip.dataset.lxSourceSelect === selected) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      }
      if (write) changed();
    };

    const select = (id: string | null, scroll = false) => {
      selected = id && panels.has(id) ? id : null;
      render();
      if (scroll && selected) reveal(panels.get(selected)!);
    };

    for (const button of lossButtons) {
      button.addEventListener('click', () => {
        const id = button.dataset.lxLoss!;
        loss = loss === id ? null : id;
        render();
      });
    }
    for (const node of nodes) {
      node.addEventListener('click', () => {
        const id = node.dataset.lxSource!;
        select(selected === id ? null : id);
      });
    }
    // An identity's sources open the source's panel, which can be far below.
    for (const chip of chips) {
      chip.addEventListener('click', (event) => {
        if (inPlace(event, chip)) select(chip.dataset.lxSourceSelect!, true);
      });
    }

    const reset = () => {
      loss = null;
      selected = null;
    };

    return {
      view,
      hasSource: (id) => panels.has(id),
      hasLoss: (id) => losses.has(id),
      reset,
      // A link restores the loss and the source it names, and a value that
      // names neither is ignored.
      restore: (params) => {
        reset();
        const wantedLoss = params.get(LOSS_PARAM);
        if (wantedLoss && losses.has(wantedLoss)) loss = wantedLoss;
        const wanted = params.get(SOURCE_PARAM);
        if (wanted && panels.has(wanted)) selected = wanted;
      },
      state: () => ({ loss, source: selected }),
      render,
    };
  }

  // The object map: the object whose panel is open, and the objects related
  // to it, each marked with its relationship read from the selected end.
  // Choosing the selected object again clears it.
  function objectsView(view: HTMLElement, changed: () => void): ObjectMap | null {
    const model: ObjectMapModel = JSON.parse(view.dataset.lxObjectsModel || '{}');
    if (!model.relations || !model.types) return null;

    const nodes = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-node]')];
    const panels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-node-panel]')].map((panel) => [panel.dataset.lxNodePanel!, panel]),
    );
    const hint = view.querySelector<HTMLElement>('[data-lx-node-hint]');

    let selected: string | null = null;

    // Two relations between one pair (an owner reference and a name) show
    // ownership, the one the garbage collector acts on.
    const relationTo = (other: string) => {
      const found = model.relations.filter(
        (relation) =>
          (relation.from === selected && relation.to === other) || (relation.to === selected && relation.from === other),
      );
      if (found.length === 0) return null;
      const relation = found.find((one) => one.type === 'owns') ?? found[0];
      const type = model.types[relation.type];
      return { type: relation.type, label: relation.from === selected ? type.label : type.inverse, text: type.text };
    };

    // An object's hint is its own, or how it relates to the one selected.
    const hintFor = (node: HTMLElement, relation: { label: string; text: string } | null) => {
      const tip = node.parentElement?.querySelector<HTMLElement>('[data-lx-tip]');
      if (tip) tip.textContent = relation ? `${relation.label}: ${relation.text}` : (tip.dataset.lxTip ?? '');
    };

    const render = (write = true) => {
      for (const node of nodes) {
        const id = node.dataset.lxNode!;
        node.setAttribute('aria-pressed', String(id === selected));
        const relation = selected && id !== selected ? relationTo(id) : null;
        const badge = node.querySelector<HTMLElement>('[data-lx-rel]');
        hintFor(node, relation);
        if (relation) {
          node.dataset.related = relation.type;
          if (badge) badge.textContent = relation.label;
        } else {
          delete node.dataset.related;
          if (badge) badge.textContent = id === selected ? 'Selected' : '';
        }
      }
      for (const [id, panel] of panels) panel.hidden = id !== selected;
      if (hint) hint.hidden = selected !== null;
      if (write) changed();
    };

    const select = (id: string | null, scroll = false) => {
      selected = id && panels.has(id) ? id : null;
      render();
      if (scroll && selected) reveal(panels.get(selected)!);
    };

    for (const node of nodes) {
      node.addEventListener('click', () => {
        const id = node.dataset.lxNode!;
        select(selected === id ? null : id);
      });
    }
    // A related object named in a panel opens its own panel, which replaces
    // this one.
    view.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLElement>('[data-lx-node-select]');
      if (link && inPlace(event, link)) select(link.dataset.lxNodeSelect!, true);
    });

    const reset = () => {
      selected = null;
    };

    return {
      view,
      hasNode: (id) => panels.has(id),
      reset,
      // A link restores the object it names, and a value that names none is
      // ignored.
      restore: (params) => {
        reset();
        const wanted = params.get(NODE_PARAM);
        if (wanted && panels.has(wanted)) selected = wanted;
      },
      state: () => ({ node: selected }),
      render,
    };
  }

  // The composed workflow: the stage a reader is at and what stopped it, if
  // anything. The stages before it read as done; a stop marks every stage
  // after it held. Another stage chosen clears the stop, so a stop chosen at
  // one stage never reads as the state of another.
  function workflowView(view: HTMLElement, changed: () => void): Workflow | null {
    const model: WorkflowModel = JSON.parse(view.dataset.lxWorkflowModel || '{}');
    if (!model.stages?.length || !model.outcomes) return null;

    const ids = model.stages.map((stage) => stage.id);
    const steps = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-wstep]')];
    const titles = steps.map((step) => step.querySelector('[data-lx-wtitle]')?.textContent?.trim() ?? '');
    const panels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-wstage-panel]')].map((panel) => [panel.dataset.lxWstagePanel!, panel]),
    );
    const count = view.querySelector<HTMLElement>('[data-lx-wcount]');
    const status = view.querySelector<HTMLElement>('[data-lx-wstatus]');
    const prev = view.querySelector<HTMLButtonElement>('[data-lx-wprev]');
    const next = view.querySelector<HTMLButtonElement>('[data-lx-wnext]');

    let index = 0;
    let outcome: string | null = null;

    const stops = (at: number, id: string) => model.stages[at]?.outcomes.includes(id) ?? false;

    const render = (write = true) => {
      const stopped = outcome !== null;
      const stop = stopped ? model.outcomes[outcome!] : '';
      steps.forEach((step, at) => {
        const current = at === index;
        if (current) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
        step.tabIndex = current ? 0 : -1;
        const state = at < index ? 'done' : current ? (stopped ? 'stopped' : 'current') : stopped ? 'held' : 'ahead';
        step.dataset.state = state;
        const mark = { done: 'Done', current: '', stopped: `Stopped: ${stop}`, held: 'Held', ahead: '' }[state];
        const badge = step.querySelector<HTMLElement>('[data-lx-wmark]');
        if (badge) badge.textContent = mark;
        step.setAttribute('aria-label', `Stage ${at + 1}: ${titles[at]}${mark ? `. ${mark}` : ''}`);
      });
      for (const [id, panel] of panels) {
        const shown = id === ids[index];
        panel.hidden = !shown;
        for (const option of panel.querySelectorAll<HTMLElement>('[data-lx-woutcome]')) {
          option.setAttribute('aria-pressed', String(shown && option.dataset.lxWoutcome === outcome));
        }
        for (const detail of panel.querySelectorAll<HTMLElement>('[data-lx-wstop]')) {
          detail.hidden = !(shown && detail.dataset.lxWstop === outcome);
        }
      }
      if (count) count.textContent = `Stage ${index + 1} of ${ids.length}: ${titles[index]}`;
      if (status) {
        const later = titles.slice(index + 1);
        status.hidden = !stopped;
        status.textContent = stopped
          ? `Stopped at ${titles[index]}: ${stop}. ${later.length > 0 ? `Held: ${later.join(', ')}.` : 'No stage follows it.'}`
          : '';
      }
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === ids.length - 1;
      if (write) changed();
    };

    const goTo = (at: number, focus = false) => {
      const target = Math.max(0, Math.min(ids.length - 1, at));
      if (target !== index) outcome = null;
      index = target;
      render();
      if (focus) steps[index]?.focus();
    };

    for (const step of steps) {
      step.addEventListener('click', () => goTo(steps.indexOf(step)));
      step.addEventListener('keydown', (event) => {
        const moves: Record<string, number> = {
          ArrowRight: index + 1,
          ArrowDown: index + 1,
          ArrowLeft: index - 1,
          ArrowUp: index - 1,
          Home: 0,
          End: ids.length - 1,
        };
        if (!(event.key in moves)) return;
        event.preventDefault();
        goTo(moves[event.key], true);
      });
    }
    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    // Choosing the stop that is shown again clears it.
    view.addEventListener('click', (event) => {
      const option = (event.target as HTMLElement).closest<HTMLElement>('[data-lx-woutcome]');
      if (!option) return;
      const id = option.dataset.lxWoutcome!;
      outcome = outcome === id ? null : stops(index, id) ? id : null;
      render();
    });

    const reset = () => {
      index = 0;
      outcome = null;
    };

    return {
      view,
      hasStage: (id) => ids.includes(id),
      reset,
      // A link restores the stage it names, the first without one, and the
      // stop it names when that stop can happen at that stage. Any other
      // value is ignored.
      restore: (params) => {
        reset();
        const wanted = ids.indexOf(params.get(STEP_PARAM) ?? '');
        if (wanted >= 0) index = wanted;
        const stop = params.get(OUTCOME_PARAM);
        if (stop && stops(index, stop)) outcome = stop;
      },
      state: () => ({ step: index === 0 ? null : ids[index], outcome }),
      render,
    };
  }

  function start(root: HTMLElement) {
    const app = root.querySelector<HTMLElement>('[data-lx-app]');
    const familyButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-lx-family]')];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-lx-view]')];
    const journey = root.querySelector<HTMLElement>('[data-lx-journey]');
    const defaultFamily = root.dataset.lxDefaultFamily ?? '';
    let current: Family | undefined;
    let audit: Audit | null = null;
    let objects: ObjectMap | null = null;
    let workflow: Workflow | null = null;
    let viewId = JOURNEY;

    // A move the reader made is a new entry in the browser's history, so
    // Back returns to the state before it. An address equal to the current
    // one adds nothing. A sandboxed frame can refuse either call; the explorer
    // works without them.
    const remember = (url: URL) => {
      try {
        if (url.href !== location.href) history.pushState(history.state, '', url);
      } catch {
        // The state still applies; only the address does not follow it.
      }
    };

    // The default view, family and path write no parameter, so a link from
    // before there were views, families or paths and a link to the defaults
    // are the same link. Each view writes its own parameters and removes the
    // others'.
    const writeUrl = () => {
      if (!current) return;
      try {
        const url = new URL(location.href);
        const drop = (params: string[]) => {
          for (const param of params) url.searchParams.delete(param);
        };
        const put = (param: string, value: string | null) => {
          if (value) url.searchParams.set(param, value);
          else url.searchParams.delete(param);
        };
        if (viewId === AUDIT && audit) {
          const state = audit.state();
          drop([...JOURNEY_PARAMS, ...OBJECT_MAP_PARAMS, ...WORKFLOW_PARAMS]);
          url.searchParams.set(VIEW_PARAM, AUDIT);
          put(LOSS_PARAM, state.loss);
          put(SOURCE_PARAM, state.source);
        } else if (viewId === OBJECTS && objects) {
          drop([...JOURNEY_PARAMS, ...AUDIT_PARAMS, ...WORKFLOW_PARAMS]);
          url.searchParams.set(VIEW_PARAM, OBJECTS);
          put(NODE_PARAM, objects.state().node);
        } else if (viewId === WORKFLOW && workflow) {
          const state = workflow.state();
          drop([...JOURNEY_PARAMS, ...AUDIT_PARAMS, ...OBJECT_MAP_PARAMS]);
          url.searchParams.set(VIEW_PARAM, WORKFLOW);
          put(STEP_PARAM, state.step);
          put(OUTCOME_PARAM, state.outcome);
        } else {
          drop([VIEW_PARAM, ...AUDIT_PARAMS, ...OBJECT_MAP_PARAMS, ...WORKFLOW_PARAMS]);
          const state = current.state();
          put(FAMILY_PARAM, current.id === defaultFamily ? null : current.id);
          put(PATH_PARAM, state.path);
          url.searchParams.set(STAGE_PARAM, state.stage);
          put(OBJECT_PARAM, state.object);
        }
        remember(url);
      } catch {
        // An address the page cannot parse leaves the state as it is.
      }
    };

    const all = [...root.querySelectorAll<HTMLElement>('[data-lx-family-view]')]
      .map((view) => family(view, writeUrl))
      .filter((one): one is Family => one !== null);
    const auditElement = root.querySelector<HTMLElement>('[data-lx-audit]');
    audit = auditElement ? auditView(auditElement, writeUrl) : null;
    const objectsElement = root.querySelector<HTMLElement>('[data-lx-objects]');
    objects = objectsElement ? objectsView(objectsElement, writeUrl) : null;
    const workflowElement = root.querySelector<HTMLElement>('[data-lx-workflow]');
    workflow = workflowElement ? workflowView(workflowElement, writeUrl) : null;
    if (!app || all.length === 0) return;
    const home = all.find((one) => one.id === defaultFamily) ?? all[0];
    const available = (id: string) =>
      id === JOURNEY ||
      (id === AUDIT && audit !== null) ||
      (id === OBJECTS && objects !== null) ||
      (id === WORKFLOW && workflow !== null);

    const show = () => {
      if (journey) journey.hidden = viewId !== JOURNEY;
      if (audit) audit.view.hidden = viewId !== AUDIT;
      if (objects) objects.view.hidden = viewId !== OBJECTS;
      if (workflow) workflow.view.hidden = viewId !== WORKFLOW;
      for (const button of viewButtons) button.setAttribute('aria-pressed', String(button.dataset.lxView === viewId));
      for (const one of all) one.view.hidden = one !== current;
      for (const button of familyButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.lxFamily === current?.id));
      }
    };

    // Draw every view from its state, the hidden ones too, so none keeps a
    // mark from before, and write the address once.
    const renderAll = (write: boolean) => {
      current!.render(false);
      audit?.render(false);
      objects?.render(false);
      workflow?.render(false);
      if (write) writeUrl();
    };

    // Another family starts afresh, at its default path and its first stage
    // with nothing selected: no path, stage or object of the family left
    // behind means anything in it.
    const chooseFamily = (id: string) => {
      const target = all.find((one) => one.id === id);
      if (!target || target === current) return;
      target.reset();
      current = target;
      show();
      target.render();
    };
    for (const button of familyButtons) button.addEventListener('click', () => chooseFamily(button.dataset.lxFamily!));

    // Every view back at its start: the change journey in the default family
    // at its default path and first stage with nothing selected, the audit
    // view with no loss and no source, the object map with no object, and
    // the workflow at its first stage with nothing stopped.
    const resetAll = () => {
      current = home;
      current.reset();
      audit?.reset();
      objects?.reset();
      workflow?.reset();
    };

    // A view starts afresh when it is chosen.
    const chooseView = (id: string) => {
      if (id === viewId || !available(id)) return;
      viewId = id;
      resetAll();
      show();
      renderAll(true);
    };
    for (const button of viewButtons) button.addEventListener('click', () => chooseView(button.dataset.lxView!));

    // An address opens the view lx-view names. Without one, it opens the
    // audit view when it names a source or a loss of it, the object map when
    // it names an object of it, the workflow when it names a stage of it, and
    // otherwise the family it names, or else the one its stage, its path or
    // its object belongs to, in that order. Whatever it does not name starts
    // afresh.
    const open = (params: URLSearchParams) => {
      const named = (param: string, has: (one: Family, value: string) => boolean) => {
        const value = params.get(param);
        return value ? all.find((one) => has(one, value)) : undefined;
      };
      const asked = params.get(VIEW_PARAM) ?? '';
      resetAll();
      if ((asked === AUDIT || asked === OBJECTS || asked === WORKFLOW) && available(asked)) viewId = asked;
      else if (audit && (audit.hasSource(params.get(SOURCE_PARAM) ?? '') || audit.hasLoss(params.get(LOSS_PARAM) ?? '')))
        viewId = AUDIT;
      else if (objects && objects.hasNode(params.get(NODE_PARAM) ?? '')) viewId = OBJECTS;
      else if (workflow && workflow.hasStage(params.get(STEP_PARAM) ?? '')) viewId = WORKFLOW;
      else viewId = JOURNEY;
      if (viewId === JOURNEY) {
        current =
          named(FAMILY_PARAM, (one, value) => one.id === value) ??
          named(STAGE_PARAM, (one, value) => one.owns(value)) ??
          named(PATH_PARAM, (one, value) => one.hasPath(value)) ??
          named(OBJECT_PARAM, (one, value) => one.hasObject(value)) ??
          home;
        current.restore(params);
      } else if (viewId === AUDIT) audit!.restore(params);
      else if (viewId === OBJECTS) objects!.restore(params);
      else workflow!.restore(params);
    };

    // What a link into another view brings into sight: the panel it opened,
    // or else the stages of the view.
    const landing = () => {
      const view =
        viewId === AUDIT ? audit!.view : viewId === OBJECTS ? objects!.view : viewId === WORKFLOW ? workflow!.view : current!.view;
      const panels = '[data-lx-object-panel], [data-lx-source-panel], [data-lx-node-panel]';
      const panel = [...view.querySelectorAll<HTMLElement>(panels)].find((one) => !one.hidden);
      return panel ?? view.querySelector<HTMLElement>('[data-lx-steps]:not([hidden]), [data-lx-wsteps]') ?? view;
    };

    // A link into another view is followed in place: the view opens as the
    // address names it, and that address is written.
    root.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lx-open]');
      if (!link || !app.contains(link) || !inPlace(event, link)) return;
      open(new URL(link.href).searchParams);
      show();
      renderAll(true);
      reveal(landing());
    });

    // The depth is the reader's, not a view's: the styles apply it, choosing
    // a view, a family or a link leaves it as it is, and the address keeps it
    // unless it is the default.
    const depthChoices = [...root.querySelectorAll<HTMLInputElement>('[data-lx-depth-choice]')];
    const defaultDepth = root.dataset.lxDefaultDepth ?? '';
    const knownDepth = (value: string | null) => depthChoices.some((choice) => choice.value === value);
    for (const choice of depthChoices) {
      choice.addEventListener('change', () => {
        if (!choice.checked) return;
        const url = new URL(location.href);
        if (choice.value === defaultDepth) url.searchParams.delete(DEPTH_PARAM);
        else url.searchParams.set(DEPTH_PARAM, choice.value);
        remember(url);
      });
    }
    const restoreDepth = (params: URLSearchParams) => {
      const asked = params.get(DEPTH_PARAM);
      const depth = knownDepth(asked) ? asked : defaultDepth;
      for (const choice of depthChoices) choice.checked = choice.value === depth;
    };

    const initial = new URLSearchParams(location.search);
    restoreDepth(initial);
    open(initial);
    app.hidden = false;
    root.dataset.lxReady = '';
    show();
    renderAll(false);

    // Escape hides every hint on screen without moving the pointer or the
    // focus; a hint shows again once the pointer or the focus has left its
    // object and come back.
    const tipped = [...root.querySelectorAll<HTMLElement>('.lx__has-tip')];
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      for (const item of tipped) {
        const tip = item.querySelector<HTMLElement>('.lx__tip');
        if (tip && getComputedStyle(tip).display !== 'none') item.dataset.lxTipDismissed = '';
      }
    });
    for (const item of tipped) {
      const restore = () => delete item.dataset.lxTipDismissed;
      item.addEventListener('pointerleave', restore);
      item.addEventListener('focusout', restore);
    }

    // Back and Forward restore the state the entry's address names, as a
    // link does, and write nothing: the entry already holds that address.
    // A move to an anchor of the page is an entry too, and restores the
    // state it was made from.
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(location.search);
      restoreDepth(params);
      open(params);
      show();
      renderAll(false);
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-lx]')) start(root);
</script>
