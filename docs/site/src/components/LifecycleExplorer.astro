---
/**
 * The lifecycle explorer on the Reconciliation page: one scenario per
 * resource family, stage by stage, the paths it can take where it turns, the
 * objects it touches, and how those objects relate.
 *
 * src/lifecycle-explorer.mjs is the content, and this file only renders it.
 * Everything is rendered here, on the server, twice: as the text a reader
 * without JavaScript, a search index or a printer gets, and as the
 * interactive view, which starts hidden. The script below shows the
 * interactive view and hides the text once it is running, so a page whose
 * script failed still reads whole. It never builds markup, only switches
 * what is shown, which is why the scoped styles below reach everything the
 * reader sees.
 *
 * Each family has a view of its own, with its paths, steps, panels and map,
 * and the script shows one of them. Within a family each stage has one panel,
 * whichever paths walk it, and each path its own list of steps. The script
 * shows the current path's list and the current stage's panel, and numbers
 * the panel by its place in that path.
 *
 * The state a reader chose, the stage, the object, a path other than the
 * default and a family other than the default, is kept in the query string
 * with replaceState: the hash stays the page's own anchor, and the browser's
 * history gains no entry per click. Choosing another family starts it afresh,
 * so no path, stage or object of one family is carried into the other.
 *
 * The audit view sits beside the change journey rather than inside a family:
 * it reads both families by evidence source. Its loss and its source are kept
 * in the query string the same way, and choosing either view starts it
 * afresh, so nothing chosen in one is carried into the other.
 */
import { actors, audit, defaultFamily, families, parentOf, relationTypes, walkOf } from '../lifecycle-explorer.mjs';

const actorLabel = new Map(actors.map((actor) => [actor.id, actor.label]));
const typeById = new Map(relationTypes.map((type) => [type.id, type]));

// The actors a stage names, the lead first, then in the fixed order.
const actorsOf = (stage) =>
  actors
    .filter((actor) => stage.actors[actor.id])
    .sort((left, right) => (left.id === stage.lead ? -1 : right.id === stage.lead ? 1 : 0))
    .map((actor) => ({ ...actor, text: stage.actors[actor.id], lead: actor.id === stage.lead }));

const titles = (stages) => stages.map((stage) => stage.title).join(', ');

// A kind name such as PtahMigrationRunAcknowledgment is one word to the
// browser, and a button holding it is as wide as the word, wider than a
// phone-width column. These are the points where it may break instead: before
// each capital that follows a lowercase letter.
const breakable = (name) => name.split(/(?<=[a-z])(?=[A-Z])/);

// Everything one family's view and its text are drawn from.
const views = families.map((family) => {
  const { scenario, paths, objects, relations } = family;
  const main = scenario.stages;
  const shape = { stages: main, paths };
  const defaultPath = paths[0].id;
  const walks = new Map(paths.map((path) => [path.id, walkOf(path, shape)]));
  const objectById = new Map(objects.map((object) => [object.id, object]));

  // Every stage once: the successful ones, then each path's own.
  const allStages = [...main, ...paths.flatMap((path) => path.stages ?? [])];

  // The path a stage is drawn in first: its own for a branch stage, the
  // default for one the successful path walks.
  const homePath = (id) => paths.find((path) => (path.stages ?? []).some((stage) => stage.id === id)) ?? paths[0];
  const isBranch = (id) => homePath(id).id !== defaultPath;
  const numberIn = (pathId, id) => walks.get(pathId).findIndex((stage) => stage.id === id) + 1;

  // Where the path can turn after a stage: the stage that follows it on the
  // path it belongs to, and the first stage of every path that turns there.
  const turnsAt = (id) => {
    const turning = paths.filter((path) => path.turnsAfter === id);
    if (turning.length === 0) return [];
    const home = homePath(id);
    const walk = walks.get(home.id);
    const next = walk[walk.findIndex((stage) => stage.id === id) + 1];
    return [{ path: home, next }, ...turning.map((path) => ({ path, next: path.stages[0] }))].filter(
      (option) => option.next,
    );
  };

  // A relation read from one end: the label is the relation's own name from
  // the object that carries it, and its inverse from the other.
  const relationsOf = (id) =>
    relations
      .filter((relation) => relation.from === id || relation.to === id)
      .map((relation) => {
        const outgoing = relation.from === id;
        const type = typeById.get(relation.type);
        return {
          type: relation.type,
          label: outgoing ? type.label : type.inverse,
          other: outgoing ? relation.to : relation.from,
          text: relation.text,
        };
      });

  const stagesOf = (id) => allStages.filter((stage) => stage.objects.includes(id));

  // What the text version says of each path. The default path is written out
  // whole; another path writes out its own stages and names the ones it
  // shares with the path it turns off, so every stage of every path is in the
  // text once in full.
  const textBlocks = paths.map((path) => {
    if (path.id === defaultPath) return { path, stages: main, start: 1 };
    const parent = parentOf(path, shape);
    const parentWalk = walks.get(parent.id);
    const turn = parentWalk.findIndex((stage) => stage.id === path.turnsAfter);
    const before = parentWalk.slice(0, turn + 1);
    const own = path.stages;
    const after = walks.get(path.id).slice(before.length + own.length);
    const from = parent.id === defaultPath ? 'the successful path' : `the path ${parent.label}`;
    return { path, from, before, stages: own, start: before.length + 1, after, afterStart: before.length + own.length + 1 };
  });

  // What the script needs and cannot read off the markup cheaply.
  const model = {
    family: family.id,
    stages: allStages.map((stage) => ({ id: stage.id, objects: stage.objects })),
    paths: paths.map((path) => ({
      id: path.id,
      walk: walks.get(path.id).map((stage) => stage.id),
      turnsAfter: path.turnsAfter ?? null,
      first: path.stages?.[0]?.id ?? null,
      parent: parentOf(path, shape)?.id ?? null,
      own: (path.stages ?? []).map((stage) => stage.id),
    })),
    defaultPath,
    relations: relations.map(({ from, to, type }) => ({ from, to, type })),
    types: Object.fromEntries(relationTypes.map((type) => [type.id, { label: type.label, inverse: type.inverse }])),
  };

  return {
    family,
    scenario,
    paths,
    objects,
    main,
    walks,
    allStages,
    objectById,
    homePath,
    isBranch,
    numberIn,
    turnsAt,
    relationsOf,
    stagesOf,
    textBlocks,
    model,
    defaultPath,
    firstWalk: walks.get(defaultPath),
  };
});

// Everything the audit view and its text are drawn from.
const verdictLabel = new Map(audit.verdicts.map((one) => [one.id, one.label]));
const basisLabel = new Map(audit.bases.map((one) => [one.id, one.label]));
const sourceById = new Map(audit.sources.map((source) => [source.id, source]));
const groupLabel = new Map(audit.groups.map((group) => [group.id, group.label]));
const sourceGroups = audit.groups.map((group) => ({
  ...group,
  sources: audit.sources.filter((source) => source.group === group.id),
}));
const issueUrl = (issue: number) => `https://github.com/stokaro/ptah-operator/issues/${issue}`;
const gapsOf = (id: string) => audit.gaps.filter((gap) => gap.sources.includes(id));
const identitiesOf = (id: string) => audit.identities.filter((identity) => identity.recordedIn.includes(id));

// What a loss leaves, counted by verdict, for the line under the loss bar.
const lossCounts = (loss: string) =>
  audit.verdicts
    .map((verdict) => ({
      label: verdict.label,
      count: audit.sources.filter((source) => source.survives[loss].verdict === verdict.id).length,
    }))
    .filter((one) => one.count > 0)
    .map((one) => `${one.label}: ${one.count}`)
    .join(', ');

// What the script needs to mark each source after a loss.
const auditModel = {
  verdicts: Object.fromEntries(audit.verdicts.map((one) => [one.id, one.label])),
  sources: Object.fromEntries(
    audit.sources.map((source) => [
      source.id,
      Object.fromEntries(audit.losses.map((loss) => [loss.id, source.survives[loss.id].verdict])),
    ]),
  ),
};
---

<section
  id="lifecycle-explorer"
  class="lx not-content"
  aria-label="Lifecycle explorer"
  data-lx
  data-lx-default-family={defaultFamily}
>
  <div class="lx__head">
    <p class="lx__eyebrow">Lifecycle explorer</p>
  </div>

  <div class="lx__app" data-lx-app data-pagefind-ignore hidden>
    <div class="lx__paths lx__views" role="group" aria-label="View">
      <span class="lx__label">View</span>
      <button type="button" class="lx__path" data-lx-view="journey" aria-pressed="true">Change journey</button>
      <button type="button" class="lx__path" data-lx-view="audit" aria-pressed="false">Audit</button>
    </div>

    <div class="lx__journey" data-lx-journey>
      <div class="lx__paths lx__families" role="group" aria-label="Resource family">
        <span class="lx__label">Family</span>
        {
          views.map((view) => (
            <button
              type="button"
              class="lx__path"
              data-lx-family={view.family.id}
              aria-pressed={String(view.family.id === defaultFamily)}
            >
              {view.family.label}
            </button>
          ))
        }
      </div>

      {
        views.map((view) => (
          <div
            class="lx__family-view"
            data-lx-family-view={view.family.id}
            data-lx-model={JSON.stringify(view.model)}
            hidden={view.family.id !== defaultFamily}
          >
            <p class="lx__title">{view.scenario.title}</p>
            <p class="lx__summary">{view.scenario.summary}</p>

            <div class="lx__paths" role="group" aria-label="Path">
              <span class="lx__label">Path</span>
              {view.paths.map((path) => (
                <button
                  type="button"
                  class="lx__path"
                  data-lx-path={path.id}
                  aria-pressed={String(path.id === view.defaultPath)}
                >
                  {path.label}
                </button>
              ))}
            </div>
            {view.paths.map((path) => (
              <p class="lx__path-summary" data-lx-path-summary={path.id} hidden={path.id !== view.defaultPath}>
                <strong>{path.title}.</strong> {path.summary}
              </p>
            ))}

            <div class="lx__bar">
              <p class="lx__count" data-lx-count aria-live="polite">
                Stage 1 of {view.firstWalk.length}: {view.firstWalk[0].title}
              </p>
              <div class="lx__nav">
                <button type="button" class="lx__button" data-lx-prev disabled>
                  Previous
                </button>
                <button type="button" class="lx__button" data-lx-next>
                  Next
                </button>
              </div>
            </div>

            {view.paths.map((path) => (
              <ol
                class="lx__steps"
                data-lx-steps={path.id}
                hidden={path.id !== view.defaultPath}
                aria-label={`Stages of the path ${path.label}. Use the arrow keys to move between them.`}
              >
                {view.walks.get(path.id).map((stage, index) => (
                  <li>
                    <button
                      type="button"
                      class="lx__step"
                      data-lx-step={stage.id}
                      data-branch={view.isBranch(stage.id) ? '' : undefined}
                      aria-current={path.id === view.defaultPath && index === 0 ? 'step' : undefined}
                      tabindex={index === 0 ? 0 : -1}
                      data-lead={stage.lead}
                      aria-label={`Stage ${index + 1}: ${stage.title}`}
                    >
                      <span class="lx__step-n">{index + 1}</span>
                      <span class="lx__step-t">{stage.title}</span>
                    </button>
                  </li>
                ))}
              </ol>
            ))}

            <div class="lx__stages">
              {view.allStages.map((stage) => (
                <div class="lx__panel" data-lx-stage-panel={stage.id} hidden={stage.id !== view.firstWalk[0].id}>
                  <div class="lx__panel-head">
                    <p class="lx__panel-title">
                      <span class="lx__panel-n" data-lx-panel-n>
                        {view.numberIn(view.homePath(stage.id).id, stage.id)}
                      </span>
                      {stage.title}
                      {view.isBranch(stage.id) && <span class="lx__branch-tag">{view.homePath(stage.id).label}</span>}
                    </p>
                    <p class="lx__phase">
                      <span class="lx__label">Phase</span> <code>{stage.phase}</code>
                    </p>
                  </div>

                  <ul class="lx__actors" aria-label="Who acts">
                    {actorsOf(stage).map((actor) => (
                      <li class="lx__actor" data-actor={actor.id} data-lead={actor.lead ? 'true' : undefined}>
                        <span class="lx__actor-name">
                          {actor.label}
                          {actor.lead && <span class="lx__lead">acts</span>}
                        </span>
                        <span class="lx__actor-text">{actor.text}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="lx__involved">
                    <span class="lx__label">Objects</span>
                    {stage.objects.map((id) => (
                      <button type="button" class="lx__chip" data-lx-select={id}>
                        {breakable(view.objectById.get(id).label).map((part, index) => (
                          <>
                            {index > 0 && <wbr />}
                            {part}
                          </>
                        ))}
                      </button>
                    ))}
                  </div>

                  {stage.expect && (
                    <p class="lx__expect">
                      <span class="lx__label">Expect</span> {stage.expect}
                    </p>
                  )}

                  <div class="lx__inspect">
                    <span class="lx__label">Inspect</span>
                    {stage.inspect.map((step) => (
                      <div class="lx__command">
                        <pre><code>{step.command}</code></pre>
                        <p>{step.says}</p>
                      </div>
                    ))}
                  </div>

                  <p class="lx__done">
                    <span class="lx__label">Done when</span> {stage.done}
                  </p>
                  {stage.limits && (
                    <p class="lx__limits">
                      <span class="lx__label">What it does not prove</span> {stage.limits}
                    </p>
                  )}

                  {view.turnsAt(stage.id).length > 0 && (
                    <div class="lx__turn" role="group" aria-label="Where the path turns">
                      <p class="lx__label">The path turns here. Choose what happens next</p>
                      <div class="lx__turn-options">
                        {view.turnsAt(stage.id).map((option) => (
                          <button
                            type="button"
                            class="lx__turn-option"
                            data-lx-choose={option.path.id}
                            data-lx-then={option.next.id}
                            aria-pressed="false"
                          >
                            <strong>{option.path.label}</strong>
                            <span>{option.next.title}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  <p class="lx__links">
                    {stage.links.map((link) => (
                      <a href={link.href}>{link.label}</a>
                    ))}
                  </p>
                </div>
              ))}
            </div>

            <div class="lx__map">
              <p class="lx__map-title">Objects and how they relate</p>
              <p class="lx__hint" data-lx-hint>
                Objects in the current stage are marked. Select one to see what it is and what it is related to.
              </p>
              <ul class="lx__nodes">
                {view.objects.map((object) => (
                  <li>
                    <button type="button" class="lx__node" data-lx-object={object.id} aria-pressed="false">
                      <span class="lx__node-label">
                        {breakable(object.label).map((part, index) => (
                          <>
                            {index > 0 && <wbr />}
                            {part}
                          </>
                        ))}
                      </span>
                      {object.kind !== object.label && <span class="lx__node-kind">{object.kind}</span>}
                      <span class="lx__node-rel" data-lx-rel />
                    </button>
                  </li>
                ))}
              </ul>

              <ul class="lx__legend" aria-label="Relationship types">
                {relationTypes.map((type) => (
                  <li data-type={type.id}>
                    <span class="lx__swatch" aria-hidden="true" />
                    <span>
                      <strong>{type.label}</strong> {type.text}
                    </span>
                  </li>
                ))}
              </ul>

              {view.objects.map((object) => (
                <div class="lx__object" data-lx-object-panel={object.id} hidden>
                  <p class="lx__panel-title">
                    <span>
                      {breakable(object.label).map((part, index) => (
                        <>
                          {index > 0 && <wbr />}
                          {part}
                        </>
                      ))}
                    </span>
                    {object.kind !== object.label && <span class="lx__node-kind">{object.kind}</span>}
                  </p>
                  <p>{object.purpose}</p>
                  <p>
                    <span class="lx__label">Where</span> {object.lives}
                  </p>
                  <p>
                    <span class="lx__label">Written by</span> {actorLabel.get(object.writer)}
                  </p>
                  <ul class="lx__relations" aria-label={`How ${object.label} relates to the others`}>
                    {view.relationsOf(object.id).map((relation) => (
                      <li data-type={relation.type}>
                        <span class="lx__swatch" aria-hidden="true" />
                        <span>
                          <strong>{relation.label}</strong>{' '}
                          <button type="button" class="lx__link-button" data-lx-select={relation.other}>
                            {breakable(view.objectById.get(relation.other).label).map((part, index) => (
                              <>
                                {index > 0 && <wbr />}
                                {part}
                              </>
                            ))}
                          </button>
                          . {relation.text}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <div class="lx__inspect">
                    <span class="lx__label">Inspect</span>
                    {object.inspect.map((step) => (
                      <div class="lx__command">
                        <pre><code>{step.command}</code></pre>
                        <p>{step.says}</p>
                      </div>
                    ))}
                  </div>
                  <p class="lx__goto">
                    <span class="lx__label">In stages</span>
                    {view.stagesOf(object.id).map((stage) => (
                      <button type="button" class="lx__chip" data-lx-goto={stage.id}>
                        {view.isBranch(stage.id)
                          ? `${view.homePath(stage.id).label}: `
                          : `${view.numberIn(view.defaultPath, stage.id)} `}
                        {stage.title}
                      </button>
                    ))}
                  </p>
                  <p class="lx__links">
                    {object.links.map((link) => (
                      <a href={link.href}>{link.label}</a>
                    ))}
                  </p>
                </div>
              ))}
            </div>

            <p class="lx__later">
              {view.family.notCovered.text}{' '}
              {view.family.notCovered.links.map((link, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
              .
            </p>
          </div>
        ))
      }
    </div>

    <div class="lx__audit" data-lx-audit data-lx-audit-model={JSON.stringify(auditModel)} hidden>
      <p class="lx__title">{audit.title}</p>
      <p class="lx__summary">{audit.summary}</p>
      <p class="lx__measured">
        {audit.measured} <a href={audit.measuredLink.href}>{audit.measuredLink.label}</a>.
      </p>

      <div class="lx__paths" role="group" aria-label="Loss">
        <span class="lx__label">After</span>
        {
          audit.losses.map((loss) => (
            <button type="button" class="lx__path" data-lx-loss={loss.id} aria-pressed="false">
              {loss.label}
            </button>
          ))
        }
      </div>
      <p class="lx__path-summary" data-lx-loss-summary="">
        Choose a loss to mark what each source keeps after it.
      </p>
      {
        audit.losses.map((loss) => (
          <p class="lx__path-summary" data-lx-loss-summary={loss.id} hidden>
            <strong>{loss.label}.</strong> {loss.text} {lossCounts(loss.id)}.
          </p>
        ))
      }

      <div class="lx__sources">
        {
          sourceGroups.map((group) => (
            <div class="lx__source-group">
              <p class="lx__map-title">{group.label}</p>
              <ul class="lx__nodes">
                {group.sources.map((source) => (
                  <li>
                    <button type="button" class="lx__node lx__source" data-lx-source={source.id} aria-pressed="false">
                      <span class="lx__node-label">{source.label}</span>
                      <span class="lx__verdict" data-lx-verdict />
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="lx__hint" data-lx-source-hint>
        Select a source to see what it records, what it cannot establish and what reads it.
      </p>
      {
        audit.sources.map((source) => (
          <div class="lx__object" data-lx-source-panel={source.id} hidden>
            <p class="lx__panel-title">
              <span>{source.label}</span>
              <span class="lx__node-kind">{groupLabel.get(source.group)}</span>
            </p>
            <p>
              <span class="lx__label">Records</span> {source.records}
            </p>
            <p>
              <span class="lx__label">Establishes</span> {source.establishes}
            </p>
            <p class="lx__limits">
              <span class="lx__label">Cannot establish</span> {source.cannot}
            </p>
            <div>
              <span class="lx__label">Joins the others by</span>
              <ul class="lx__ids">
                {source.ids.map((id) => (
                  <li>{id}</li>
                ))}
              </ul>
            </div>
            <div class="lx__inspect">
              <span class="lx__label">Read it with</span>
              {source.readers.map((reader) => (
                <div class="lx__command">
                  {reader.command ? (
                    <pre><code>{reader.command}</code></pre>
                  ) : (
                    <p class="lx__system">{reader.system}</p>
                  )}
                  <p>{reader.says}</p>
                </div>
              ))}
            </div>
            <p>
              <span class="lx__label">Kept</span> {source.retention}
            </p>
            <ul class="lx__survives" aria-label={`What is left of ${source.label} after a loss`}>
              {audit.losses.map((loss) => (
                <li data-lx-survives={loss.id} data-verdict={source.survives[loss.id].verdict}>
                  <strong>{loss.label}</strong>
                  <span class="lx__verdict-tag">{verdictLabel.get(source.survives[loss.id].verdict)}</span>
                  <span>
                    {source.survives[loss.id].text}{' '}
                    <span class="lx__basis">({basisLabel.get(source.survives[loss.id].basis)})</span>
                  </span>
                </li>
              ))}
            </ul>
            {identitiesOf(source.id).length > 0 && (
              <p>
                <span class="lx__label">Names</span>{' '}
                {identitiesOf(source.id)
                  .map((identity) => identity.label)
                  .join(', ')}
              </p>
            )}
            {gapsOf(source.id).length > 0 && (
              <p class="lx__gap-links">
                <span class="lx__label">Gaps closed</span>
                {gapsOf(source.id).map((gap) => (
                  <a href={issueUrl(gap.issue)}>
                    #{gap.issue} in {gap.version}
                  </a>
                ))}
              </p>
            )}
            <p class="lx__links">
              {source.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </p>
          </div>
        ))
      }

      <div class="lx__map">
        <p class="lx__map-title">Identities an audit keeps apart</p>
        <ul class="lx__identities">
          {
            audit.identities.map((identity) => (
              <li data-lx-identity={identity.id}>
                <p>
                  <strong>{identity.label}.</strong> {identity.text}
                </p>
                <p class="lx__note">{identity.note}</p>
                <p class="lx__goto">
                  <span class="lx__label">Recorded in</span>
                  {identity.recordedIn.map((id) => (
                    <button type="button" class="lx__chip" data-lx-source-select={id}>
                      {sourceById.get(id).label}
                    </button>
                  ))}
                </p>
              </li>
            ))
          }
        </ul>
        <ul class="lx__distinctions">
          {
            audit.distinctions.map((distinction) => (
              <li>{distinction}</li>
            ))
          }
        </ul>
      </div>

      <div class="lx__map">
        <p class="lx__map-title">Gaps since closed</p>
        <ul class="lx__gaps">
          {
            audit.gaps.map((gap) => (
              <li data-lx-gap={gap.issue}>
                <a href={issueUrl(gap.issue)}>#{gap.issue}</a>, closed in {gap.version}: <strong>{gap.title}.</strong>{' '}
                {gap.text}
              </li>
            ))
          }
        </ul>
        <p class="lx__deferred">
          Still deferred, as <a href={audit.deferredLink.href}>{audit.deferredLink.label}</a> record:{' '}
          {
            audit.deferred.map((item, index) => (
              <>
                {index > 0 && ' '}
                <strong>{item.title}.</strong> {item.text}
              </>
            ))
          }
        </p>
      </div>

      <p class="lx__later">
        Read more:{' '}
        {
          audit.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>
  </div>

  <div class="lx__text" data-lx-text>
    {
      views.map((view) => (
        <div class="lx__text-family" data-lx-text-family={view.family.id}>
          <p class="lx__title">{view.scenario.title}</p>
          <p class="lx__summary">{view.scenario.summary}</p>
          {view.textBlocks.map((block) => (
            <div class="lx__text-path" data-lx-text-path={block.path.id}>
              <p>
                <strong>Path: {block.path.title}.</strong> {block.path.summary}
                {block.before && (
                  <>
                    {' '}
                    Stages 1 to {block.before.length} are those of {block.from}: {titles(block.before)}. Then:
                  </>
                )}
              </p>
              <ol class="lx__text-stages" start={block.start}>
                {block.stages.map((stage) => (
                  <li data-lx-text-stage={stage.id}>
                    <p>
                      <strong>{stage.title}.</strong> Phase <code>{stage.phase}</code>.
                    </p>
                    <ul>
                      {actorsOf(stage).map((actor) => (
                        <li>
                          <strong>{actor.label}:</strong> {actor.text}
                        </li>
                      ))}
                    </ul>
                    <p>Objects: {stage.objects.map((id) => view.objectById.get(id).label).join(', ')}.</p>
                    {stage.expect && <p>Expect: {stage.expect}</p>}
                    {stage.inspect.map((step) => (
                      <p>
                        <code>{step.command}</code>: {step.says}
                      </p>
                    ))}
                    <p>Done when: {stage.done}</p>
                    {stage.limits && <p>What it does not prove: {stage.limits}</p>}
                    <p>
                      Read more:{' '}
                      {stage.links.map((link, index) => (
                        <>
                          {index > 0 && ', '}
                          <a href={link.href}>{link.label}</a>
                        </>
                      ))}
                      .
                    </p>
                  </li>
                ))}
              </ol>
              {block.after && block.after.length > 0 && (
                <p>
                  Stages {block.afterStart} to {block.afterStart + block.after.length - 1} are those of {block.from}{' '}
                  again: {titles(block.after)}.
                </p>
              )}
              {block.after && block.after.length === 0 && <p>The path ends here.</p>}
            </div>
          ))}
          <p>
            <strong>The objects, and how they relate.</strong> An owner reference is what the garbage collector
            follows; a name, a UID or a digest is a reference and deletes nothing.
          </p>
          <ul class="lx__text-objects">
            {view.objects.map((object) => (
              <li data-lx-text-object={object.id}>
                <strong>{object.label}</strong> ({object.kind}). {object.purpose} {object.lives}
                <ul>
                  {view.relationsOf(object.id).map((relation) => (
                    <li>
                      {relation.label} {view.objectById.get(relation.other).label}: {relation.text}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          <p class="lx__later">
            {view.family.notCovered.text}{' '}
            {view.family.notCovered.links.map((link, index) => (
              <>
                {index > 0 && ', '}
                <a href={link.href}>{link.label}</a>
              </>
            ))}
            .
          </p>
        </div>
      ))
    }
    <div class="lx__text-family lx__text-audit" data-lx-text-audit>
      <p class="lx__title">Audit: {audit.title}</p>
      <p class="lx__summary">{audit.textSummary}</p>
      <p>
        {audit.measured} <a href={audit.measuredLink.href}>{audit.measuredLink.label}</a>.
      </p>
      {
        sourceGroups.map((group) => (
          <div class="lx__text-path" data-lx-text-group={group.id}>
            <p>
              <strong>{group.label}.</strong>
            </p>
            <ul class="lx__text-objects">
              {group.sources.map((source) => (
                <li data-lx-text-source={source.id}>
                  <p>
                    <strong>{source.label}.</strong> {source.records}
                  </p>
                  <p>Establishes: {source.establishes}</p>
                  <p>Cannot establish: {source.cannot}</p>
                  <p>Joins the others by: {source.ids.join('; ')}.</p>
                  {source.readers.map((reader) =>
                    reader.command ? (
                      <p>
                        <code>{reader.command}</code>: {reader.says}
                      </p>
                    ) : (
                      <p>
                        {reader.system} {reader.says}
                      </p>
                    ),
                  )}
                  <p>Kept: {source.retention}</p>
                  <ul>
                    {audit.losses.map((loss) => (
                      <li data-lx-text-survives={loss.id}>
                        {loss.label}: {verdictLabel.get(source.survives[loss.id].verdict)},{' '}
                        {basisLabel.get(source.survives[loss.id].basis)}. {source.survives[loss.id].text}
                      </li>
                    ))}
                  </ul>
                  <p>
                    Read more:{' '}
                    {source.links.map((link, index) => (
                      <>
                        {index > 0 && ', '}
                        <a href={link.href}>{link.label}</a>
                      </>
                    ))}
                    .
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="lx__text-path">
        <p>
          <strong>Identities an audit keeps apart.</strong>
        </p>
        <ul class="lx__text-objects">
          {
            audit.identities.map((identity) => (
              <li data-lx-text-identity={identity.id}>
                <strong>{identity.label}.</strong> {identity.text} {identity.note} Recorded in:{' '}
                {identity.recordedIn.map((id) => sourceById.get(id).label).join(', ')}.
              </li>
            ))
          }
        </ul>
        {
          audit.distinctions.map((distinction) => (
            <p>{distinction}</p>
          ))
        }
      </div>
      <div class="lx__text-path">
        <p>
          <strong>Gaps since closed.</strong>
        </p>
        <ul class="lx__text-objects">
          {
            audit.gaps.map((gap) => (
              <li data-lx-text-gap={gap.issue}>
                <a href={issueUrl(gap.issue)}>#{gap.issue}</a>, closed in {gap.version}: <strong>{gap.title}.</strong>{' '}
                {gap.text}
              </li>
            ))
          }
        </ul>
        <p>
          Still deferred, as <a href={audit.deferredLink.href}>{audit.deferredLink.label}</a> record:{' '}
          {
            audit.deferred.map((item, index) => (
              <>
                {index > 0 && ' '}
                <strong>{item.title}.</strong> {item.text}
              </>
            ))
          }
        </p>
      </div>
      <p class="lx__later">
        Read more:{' '}
        {
          audit.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>
  </div>
</section>

<style>
  .lx {
    --lx-gap: 0.75rem;
    container-type: inline-size;
    margin-block: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    background: var(--ptah-surface);
    line-height: 1.5;
    font-size: 0.9375rem;
    /* A reason such as ConvergedAfterUnknownOutcome is one word wider than a
     * 320px column; it breaks rather than widening the explorer. */
    overflow-wrap: break-word;
  }

  .lx [hidden] {
    display: none !important;
  }

  .lx p,
  .lx ul,
  .lx ol {
    margin: 0;
  }

  .lx :is(p, ul, ol, div) + :is(p, ul, ol, div) {
    margin-top: var(--lx-gap);
  }

  .lx__eyebrow,
  .lx__label,
  .lx__map-title {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lx__label {
    margin-right: 0.35rem;
  }

  .lx__title {
    color: var(--sl-color-white);
    font-size: var(--sl-text-h3);
    font-weight: 600;
  }

  .lx__summary,
  .lx__hint,
  .lx__later {
    color: var(--sl-color-gray-2);
  }

  .lx code {
    overflow-wrap: break-word;
    font-size: var(--sl-text-code-sm);
  }

  /* The root is not-content, so Starlight's prose rules stay out of the
   * layout; the links still read as the page's links. */
  .lx a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lx__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .lx__count {
    color: var(--sl-color-gray-2);
  }

  .lx__nav {
    display: flex;
    gap: 0.5rem;
  }

  .lx .lx__nav,
  .lx .lx__steps {
    margin-top: 0;
  }

  .lx__steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.375rem;
    padding: 0;
    list-style: none;
    margin-top: var(--lx-gap) !important;
  }

  .lx__steps li {
    margin: 0 !important;
  }

  .lx__button,
  .lx__step,
  .lx__chip,
  .lx__node {
    font: inherit;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    cursor: pointer;
  }

  .lx__button {
    padding: 0.35rem 0.8rem;
  }

  .lx__button:disabled {
    color: var(--sl-color-gray-3);
    cursor: default;
  }

  .lx__step {
    display: flex;
    width: 100%;
    height: 100%;
    gap: 0.4rem;
    align-items: flex-start;
    padding: 0.4rem 0.5rem;
    text-align: left;
    font-size: var(--sl-text-xs);
    line-height: 1.3;
  }

  .lx__step-n,
  .lx__panel-n {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-4);
    font-variant-numeric: tabular-nums;
  }

  .lx__step[aria-current='step'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .lx__step[aria-current='step'] .lx__step-n,
  .lx__panel-n {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }

  .lx__step[data-done] .lx__step-n {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .lx__panel,
  .lx__object {
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .lx__panel-head > * {
    margin-top: 0 !important;
  }

  .lx__panel-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h4);
    font-weight: 600;
  }

  .lx__actors {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .lx__actor {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0 !important;
    padding: 0.5rem 0.625rem;
    border-left: 3px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }

  .lx__actor[data-lead] {
    border-left-color: var(--sl-color-accent);
  }

  .lx__actor-name {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .lx__lead {
    display: block;
    color: var(--sl-color-accent);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }

  .lx__involved,
  .lx__goto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .lx__chip {
    padding: 0.15rem 0.55rem;
    font-size: var(--sl-text-xs);
  }

  .lx__chip[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .lx__command {
    margin-top: 0.375rem !important;
  }

  .lx__command pre {
    margin: 0;
    padding: 0.5rem 0.625rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-inline-code);
    font-size: var(--sl-text-code-sm);
    line-height: 1.5;
  }

  /* A command keeps its lines as typed, so a flag never breaks at its hyphen;
   * a long one scrolls inside its own box rather than widening the page. */
  .lx__command pre code {
    white-space: pre;
    overflow-wrap: normal;
  }

  .lx__command p {
    margin-top: 0.25rem !important;
    color: var(--sl-color-gray-2);
  }

  .lx__limits {
    padding-left: 0.625rem;
    border-left: 3px solid var(--ptah-amber);
  }

  .lx__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .lx__map {
    margin-top: 1.25rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__nodes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .lx__nodes li {
    margin: 0 !important;
  }

  .lx__node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    width: 100%;
    height: 100%;
    padding: 0.5rem 0.625rem;
    text-align: left;
    border-width: 2px;
    border-color: var(--sl-color-hairline);
  }

  /* A part such as Acknowledgment is wider than a node in two columns of
   * a 320px screen, so the map takes one column there (below). Should a part
   * still not fit, it breaks rather than reaching past the node. */
  .lx__node-label {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .lx__node-kind {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .lx__node-rel {
    color: var(--sl-color-accent);
    font-size: var(--sl-text-xs);
  }

  .lx__node[data-in-stage] {
    background: var(--sl-color-accent-low);
  }

  .lx__node[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    border-style: solid;
  }

  /* A related node carries its relation's line style, the one the legend
   * draws, so the type reads without color as well. */
  .lx__node[data-related='owns'] {
    border-color: var(--sl-color-gray-2);
    border-style: solid;
  }
  .lx__node[data-related='references'] {
    border-color: var(--sl-color-gray-2);
    border-style: dashed;
  }
  .lx__node[data-related='contains'] {
    border-color: var(--sl-color-gray-2);
    border-style: double;
    border-width: 3px;
  }
  .lx__node[data-related='holds'] {
    border-color: var(--ptah-amber);
    border-style: dotted;
  }
  .lx__node[data-related='delivers'] {
    border-color: var(--ptah-green);
    border-style: dashed;
  }

  .lx__legend,
  .lx__relations {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }

  .lx__relations {
    font-size: inherit;
  }

  .lx__legend li,
  .lx__relations li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    margin: 0 !important;
  }

  .lx__legend strong,
  .lx__relations strong {
    color: var(--sl-color-white);
  }

  .lx__swatch {
    display: block;
    height: 0;
    border-top: 2px solid var(--sl-color-gray-2);
    transform: translateY(-0.25em);
  }

  [data-type='references'] > .lx__swatch {
    border-top-style: dashed;
  }
  [data-type='contains'] > .lx__swatch {
    border-top: 4px double var(--sl-color-gray-2);
  }
  [data-type='holds'] > .lx__swatch {
    border-top: 3px dotted var(--ptah-amber);
  }
  [data-type='delivers'] > .lx__swatch {
    border-top: 2px dashed var(--ptah-green);
  }

  .lx__link-button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--sl-color-text-accent);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }

  .lx__text-stages,
  .lx__text-objects {
    padding-left: 1.25rem;
  }

  .lx__text li + li {
    margin-top: 0.75rem;
  }

  .lx__text ul {
    padding-left: 1.1rem;
  }

  .lx__text li li + li {
    margin-top: 0.25rem;
  }

  .lx__text p + p {
    margin-top: 0.25rem;
  }

  .lx__later {
    margin-top: 1rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
  }

  /* The path bar: one button per path, the current one pressed. */
  .lx__paths {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .lx__paths .lx__label {
    margin-right: 0.15rem;
  }

  .lx__path {
    padding: 0.25rem 0.7rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    cursor: pointer;
  }

  .lx__path[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .lx__path-summary {
    color: var(--sl-color-gray-2);
  }

  .lx__path-summary strong {
    color: var(--sl-color-white);
  }

  /* A stage only another path walks: its own line style, so the turn reads
   * without color as well. */
  .lx__step[data-branch] {
    border-style: dashed;
    border-color: var(--ptah-amber);
  }

  .lx__step[data-branch][aria-current='step'] {
    border-style: solid;
    border-color: var(--sl-color-accent);
  }

  .lx__branch-tag {
    padding: 0 0.45rem;
    border: 1px dashed var(--ptah-amber);
    border-radius: 2px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }

  .lx__turn {
    padding: 0.5rem 0.625rem;
    border: 1px dashed var(--ptah-amber);
    background: var(--sl-color-bg);
  }

  .lx__turn-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.375rem;
    margin-top: 0.375rem !important;
  }

  .lx__turn-option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.4rem 0.6rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    text-align: left;
    color: var(--sl-color-text);
    background: var(--ptah-surface);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    cursor: pointer;
  }

  .lx__turn-option strong {
    color: var(--sl-color-white);
  }

  .lx__turn-option span {
    color: var(--sl-color-gray-2);
  }

  .lx__turn-option[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .lx__text-path + .lx__text-path {
    margin-top: 1rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx__path:focus-visible,
  .lx__turn-option:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* The family bar switches the whole view below it, so it stands apart
   * from the path bar inside that view. */
  .lx__families {
    padding-bottom: var(--lx-gap);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .lx__text-family + .lx__text-family {
    margin-top: 1.5rem !important;
    padding-top: var(--lx-gap);
    border-top: 1px solid var(--sl-color-hairline);
  }

  /* The view bar switches everything below it, the family bar included. */
  .lx__views {
    padding-bottom: var(--lx-gap);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .lx__measured,
  .lx__note,
  .lx__deferred {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
  }

  .lx__basis,
  .lx__verdict {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .lx__source[aria-pressed='true'] {
    background: var(--sl-color-accent-low);
  }

  /* After a loss, each source carries its verdict in a line style of its own
   * as well as in words, so it reads without color. These come after the
   * pressed rule, so a selected source keeps its verdict's border. */
  .lx__source[data-verdict='kept'] {
    border-color: var(--ptah-green);
    border-style: solid;
  }
  .lx__source[data-verdict='gone'] {
    border-color: var(--sl-color-gray-3);
    border-style: dashed;
  }
  .lx__source[data-verdict='outside'] {
    border-color: var(--ptah-amber);
    border-style: dotted;
  }

  .lx__ids,
  .lx__distinctions,
  .lx__gaps {
    padding-left: 1.1rem;
  }

  .lx__ids li + li,
  .lx__distinctions li + li,
  .lx__gaps li + li {
    margin-top: 0.25rem;
  }

  .lx__system {
    padding: 0.5rem 0.625rem;
    border: 1px dashed var(--sl-color-hairline);
  }

  .lx__survives,
  .lx__identities {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }

  .lx__survives li {
    display: grid;
    grid-template-columns: 9rem auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    margin: 0 !important;
    padding: 0.25rem 0.5rem;
    border-left: 3px solid var(--sl-color-hairline);
  }
  .lx__survives li[data-verdict='kept'] {
    border-left-color: var(--ptah-green);
  }
  .lx__survives li[data-verdict='gone'] {
    border-left-color: var(--sl-color-gray-3);
    border-left-style: dashed;
  }
  .lx__survives li[data-verdict='outside'] {
    border-left-color: var(--ptah-amber);
    border-left-style: dotted;
  }
  .lx__survives li[data-current] {
    background: var(--sl-color-accent-low);
  }

  .lx__verdict-tag {
    padding: 0 0.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .lx__identities li {
    margin: 0 !important;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }

  .lx__identities li > * + * {
    margin-top: 0.375rem;
  }

  .lx__gap-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  /* Once the script runs, the interactive view replaces the text. */
  .lx[data-lx-ready] .lx__text {
    display: none;
  }

  @container (max-width: 34rem) {
    .lx__step {
      justify-content: center;
      padding: 0.4rem 0.2rem;
    }
    .lx__step-t {
      display: none;
    }
    .lx__actor {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
    .lx__lead {
      display: inline;
      margin-left: 0.4rem;
    }
    .lx__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lx__survives li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .lx__survives li > :last-child {
      grid-column: 1 / -1;
    }
  }

  @container (min-width: 34.01rem) and (max-width: 44rem) {
    .lx__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (max-width: 18rem) {
    .lx__nodes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lx__panel:not([hidden]),
    .lx__object:not([hidden]) {
      animation: lx-in 160ms ease-out;
    }
    @keyframes lx-in {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
    }
  }

  @media print {
    .lx__app {
      display: none !important;
    }
    .lx[data-lx-ready] .lx__text {
      display: block;
    }
  }
</style>

<script>
  type PathModel = {
    id: string;
    walk: string[];
    turnsAfter: string | null;
    first: string | null;
    parent: string | null;
    own: string[];
  };
  type Model = {
    family: string;
    stages: { id: string; objects: string[] }[];
    paths: PathModel[];
    defaultPath: string;
    relations: { from: string; to: string; type: string }[];
    types: Record<string, { label: string; inverse: string }>;
  };
  type Family = {
    id: string;
    view: HTMLElement;
    owns: (stage: string) => boolean;
    hasPath: (path: string) => boolean;
    hasObject: (object: string) => boolean;
    reset: () => void;
    restore: (params: URLSearchParams) => void;
    state: () => { path: string | null; stage: string; object: string | null };
    render: (write?: boolean) => void;
  };
  type AuditModel = {
    verdicts: Record<string, string>;
    sources: Record<string, Record<string, string>>;
  };
  type Audit = {
    view: HTMLElement;
    hasSource: (source: string) => boolean;
    hasLoss: (loss: string) => boolean;
    reset: () => void;
    restore: (params: URLSearchParams) => void;
    state: () => { loss: string | null; source: string | null };
    render: (write?: boolean) => void;
  };

  const FAMILY_PARAM = 'lx-family';
  const STAGE_PARAM = 'lx-stage';
  const OBJECT_PARAM = 'lx-object';
  const PATH_PARAM = 'lx-path';
  const VIEW_PARAM = 'lx-view';
  const LOSS_PARAM = 'lx-loss';
  const SOURCE_PARAM = 'lx-source';
  const AUDIT = 'audit';
  const JOURNEY_PARAMS = [FAMILY_PARAM, PATH_PARAM, STAGE_PARAM, OBJECT_PARAM];
  const AUDIT_PARAMS = [VIEW_PARAM, LOSS_PARAM, SOURCE_PARAM];

  const reveal = (element: HTMLElement) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    element.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
  };

  // One family's view: the path, the stage and the selection a reader chose
  // in it, and the controls that move them. `changed` writes the address, and
  // is called only once the reader chose something.
  function family(view: HTMLElement, changed: () => void): Family | null {
    const model: Model = JSON.parse(view.dataset.lxModel || '{}');
    if (!model.stages?.length || !model.paths?.length) return null;

    const stageObjects = new Map(model.stages.map((stage) => [stage.id, stage.objects]));
    const pathById = new Map(model.paths.map((path) => [path.id, path]));
    const lists = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-steps]')].map((list) => [list.dataset.lxSteps!, list]),
    );
    const stepsOf = (id: string) => [...(lists.get(id)?.querySelectorAll<HTMLButtonElement>('[data-lx-step]') ?? [])];
    const allSteps = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-step]')];
    const stagePanels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-stage-panel]')].map((panel) => [panel.dataset.lxStagePanel, panel]),
    );
    const pathButtons = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-path]')];
    const summaries = [...view.querySelectorAll<HTMLElement>('[data-lx-path-summary]')];
    const nodes = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-object]')];
    const objectPanels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-object-panel]')].map((panel) => [panel.dataset.lxObjectPanel, panel]),
    );
    const count = view.querySelector<HTMLElement>('[data-lx-count]');
    const prev = view.querySelector<HTMLButtonElement>('[data-lx-prev]');
    const next = view.querySelector<HTMLButtonElement>('[data-lx-next]');

    let pathId = model.defaultPath;
    let stageIndex = 0;
    let selected: string | null = null;

    const walk = () => pathById.get(pathId)!.walk;
    const currentStage = () => walk()[stageIndex];
    // The path a stage belongs to when the current one does not walk it: the
    // default if it walks it, else the path whose own stage it is, else any
    // path that walks it.
    const pathWalking = (stage: string) =>
      pathById.get(model.defaultPath)!.walk.includes(stage)
        ? model.defaultPath
        : (model.paths.find((path) => path.own.includes(stage))?.id ??
          model.paths.find((path) => path.walk.includes(stage))?.id ??
          null);

    // The relation between the selected object and another, read from the
    // selected end. Two relations between one pair (a reference and an owner
    // reference) show ownership, the one the garbage collector acts on.
    const relationTo = (other: string) => {
      const found = model.relations.filter(
        (relation) =>
          (relation.from === selected && relation.to === other) || (relation.to === selected && relation.from === other),
      );
      if (found.length === 0) return null;
      const relation = found.find((one) => one.type === 'owns') ?? found[0];
      const type = model.types[relation.type];
      return { type: relation.type, label: relation.from === selected ? type.label : type.inverse };
    };

    // The URL changes only after the reader chose something, so a page that
    // was merely opened keeps the address it was opened at.
    const render = (write = true) => {
      const stage = currentStage();
      const steps = stepsOf(pathId);
      for (const [id, list] of lists) list.hidden = id !== pathId;
      for (const step of allSteps) {
        step.removeAttribute('aria-current');
        delete step.dataset.done;
      }
      steps.forEach((step, index) => {
        const current = index === stageIndex;
        if (current) step.setAttribute('aria-current', 'step');
        step.tabIndex = current ? 0 : -1;
        if (index < stageIndex) step.dataset.done = '';
      });
      for (const [id, panel] of stagePanels) {
        panel.hidden = id !== stage;
        if (id !== stage) continue;
        const number = panel.querySelector<HTMLElement>('[data-lx-panel-n]');
        if (number) number.textContent = String(stageIndex + 1);
        const following = walk()[stageIndex + 1] ?? null;
        for (const option of panel.querySelectorAll<HTMLElement>('[data-lx-choose]')) {
          option.setAttribute('aria-pressed', String(option.dataset.lxThen === following));
        }
      }
      const title = steps[stageIndex]?.querySelector('.lx__step-t')?.textContent ?? '';
      if (count) count.textContent = `Stage ${stageIndex + 1} of ${walk().length}: ${title}`;
      if (prev) prev.disabled = stageIndex === 0;
      if (next) next.disabled = stageIndex === walk().length - 1;
      for (const button of pathButtons) button.setAttribute('aria-pressed', String(button.dataset.lxPath === pathId));
      for (const summary of summaries) summary.hidden = summary.dataset.lxPathSummary !== pathId;

      const inStage = stageObjects.get(stage) ?? [];
      for (const node of nodes) {
        const id = node.dataset.lxObject!;
        if (inStage.includes(id)) node.dataset.inStage = '';
        else delete node.dataset.inStage;
        node.setAttribute('aria-pressed', String(id === selected));
        const relation = selected && id !== selected ? relationTo(id) : null;
        const badge = node.querySelector<HTMLElement>('[data-lx-rel]');
        if (relation) {
          node.dataset.related = relation.type;
          if (badge) badge.textContent = relation.label;
        } else {
          delete node.dataset.related;
          if (badge) badge.textContent = id === selected ? 'Selected' : '';
        }
      }
      for (const chip of view.querySelectorAll<HTMLElement>('.lx__involved [data-lx-select]')) {
        chip.setAttribute('aria-pressed', String(chip.dataset.lxSelect === selected));
      }
      for (const [id, panel] of objectPanels) panel.hidden = id !== selected;
      if (write) changed();
    };

    const focusStep = () => stepsOf(pathId)[stageIndex]?.focus();

    const goTo = (index: number, focus = false) => {
      stageIndex = Math.max(0, Math.min(walk().length - 1, index));
      render();
      if (focus) focusStep();
    };

    // Switch to a path at a stage it walks, or at its first stage if it walks
    // none by that id.
    const setPath = (id: string, stage: string | null, focus = false) => {
      if (!pathById.has(id)) return;
      pathId = id;
      stageIndex = Math.max(0, stage ? walk().indexOf(stage) : 0);
      render();
      if (focus) focusStep();
    };

    // A path chosen from the bar keeps the stage when the new path walks it
    // too. Otherwise it opens where the two differ: going back to a path the
    // current one turned off, directly or through another, at the stage where
    // it left that path; going anywhere else, at the new path's first own
    // stage.
    const choosePath = (id: string) => {
      const target = pathById.get(id);
      if (!target || id === pathId) return;
      const stage = currentStage();
      if (target.walk.includes(stage)) {
        setPath(id, stage);
        return;
      }
      let from = pathById.get(pathId);
      for (let hops = 0; from?.parent && hops < model.paths.length; hops += 1) {
        if (from.parent === id) {
          setPath(id, from.turnsAfter);
          return;
        }
        from = pathById.get(from.parent);
      }
      setPath(id, target.first);
    };

    const select = (id: string | null, scroll = false) => {
      selected = id && objectPanels.has(id) ? id : null;
      render();
      if (scroll && selected) reveal(objectPanels.get(selected)!);
    };

    for (const step of allSteps) {
      step.addEventListener('click', () => {
        const index = stepsOf(pathId).indexOf(step);
        if (index >= 0) goTo(index);
      });
      step.addEventListener('keydown', (event) => {
        const moves: Record<string, number> = {
          ArrowRight: stageIndex + 1,
          ArrowDown: stageIndex + 1,
          ArrowLeft: stageIndex - 1,
          ArrowUp: stageIndex - 1,
          Home: 0,
          End: walk().length - 1,
        };
        if (!(event.key in moves)) return;
        event.preventDefault();
        goTo(moves[event.key], true);
      });
    }
    prev?.addEventListener('click', () => goTo(stageIndex - 1));
    next?.addEventListener('click', () => goTo(stageIndex + 1));
    for (const button of pathButtons) button.addEventListener('click', () => choosePath(button.dataset.lxPath!));

    for (const node of nodes) {
      node.addEventListener('click', () => {
        const id = node.dataset.lxObject!;
        select(selected === id ? null : id);
      });
    }
    view.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const chip = target.closest<HTMLElement>('[data-lx-select]');
      if (chip) select(chip.dataset.lxSelect!, true);
      // A turn goes on along the current path when that path takes it, and
      // switches to the path that does otherwise. Focus moves to the stage it
      // reached, since the panel that held the choice is now hidden.
      const choice = target.closest<HTMLElement>('[data-lx-choose]');
      if (choice) {
        const following = choice.dataset.lxThen!;
        if (walk()[stageIndex + 1] === following) goTo(stageIndex + 1, true);
        else setPath(choice.dataset.lxChoose!, following, true);
      }
      const goto = target.closest<HTMLElement>('[data-lx-goto]');
      if (goto) {
        const stage = goto.dataset.lxGoto!;
        if (walk().includes(stage)) goTo(walk().indexOf(stage));
        else setPath(pathWalking(stage) ?? model.defaultPath, stage);
        stepsOf(pathId)[stageIndex]?.scrollIntoView({ block: 'nearest' });
      }
    });

    const reset = () => {
      pathId = model.defaultPath;
      stageIndex = 0;
      selected = null;
    };

    return {
      id: model.family,
      view,
      owns: (stage) => stageObjects.has(stage),
      hasPath: (path) => pathById.has(path),
      hasObject: (object) => objectPanels.has(object),
      reset,
      // A link restores what it names of this family and keeps the default
      // for the rest, so a value that belongs to another family is ignored. A
      // link that names a stage of another path and no path opens that
      // stage's path.
      restore: (params) => {
        reset();
        const wantedStage = params.get(STAGE_PARAM) ?? '';
        const wantedPath = params.get(PATH_PARAM);
        if (wantedPath && pathById.has(wantedPath)) pathId = wantedPath;
        else if (wantedStage) pathId = pathWalking(wantedStage) ?? model.defaultPath;
        const wanted = walk().indexOf(wantedStage);
        if (wanted >= 0) stageIndex = wanted;
        const object = params.get(OBJECT_PARAM);
        if (object && objectPanels.has(object)) selected = object;
      },
      state: () => ({ path: pathId === model.defaultPath ? null : pathId, stage: currentStage(), object: selected }),
      render,
    };
  }

  // The audit view: the loss a reader chose, which marks what each source
  // keeps after it, and the source whose detail is open. Choosing the pressed
  // loss or the selected source again clears it.
  function auditView(view: HTMLElement, changed: () => void): Audit | null {
    const model: AuditModel = JSON.parse(view.dataset.lxAuditModel || '{}');
    if (!model.sources || !model.verdicts) return null;

    const lossButtons = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-loss]')];
    const summaries = [...view.querySelectorAll<HTMLElement>('[data-lx-loss-summary]')];
    const nodes = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-source]')];
    const chips = [...view.querySelectorAll<HTMLButtonElement>('[data-lx-source-select]')];
    const panels = new Map(
      [...view.querySelectorAll<HTMLElement>('[data-lx-source-panel]')].map((panel) => [panel.dataset.lxSourcePanel!, panel]),
    );
    const hint = view.querySelector<HTMLElement>('[data-lx-source-hint]');
    const losses = new Set(lossButtons.map((button) => button.dataset.lxLoss!));

    let loss: string | null = null;
    let selected: string | null = null;

    const render = (write = true) => {
      for (const button of lossButtons) button.setAttribute('aria-pressed', String(button.dataset.lxLoss === loss));
      for (const summary of summaries) summary.hidden = (summary.dataset.lxLossSummary || null) !== loss;
      for (const node of nodes) {
        const id = node.dataset.lxSource!;
        node.setAttribute('aria-pressed', String(id === selected));
        const verdict = loss ? model.sources[id]?.[loss] : undefined;
        if (verdict) node.dataset.verdict = verdict;
        else delete node.dataset.verdict;
        const badge = node.querySelector<HTMLElement>('[data-lx-verdict]');
        if (badge) badge.textContent = verdict ? (model.verdicts[verdict] ?? '') : '';
      }
      for (const [id, panel] of panels) {
        panel.hidden = id !== selected;
        for (const row of panel.querySelectorAll<HTMLElement>('[data-lx-survives]')) {
          if (row.dataset.lxSurvives === loss) row.dataset.current = '';
          else delete row.dataset.current;
        }
      }
      if (hint) hint.hidden = selected !== null;
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.lxSourceSelect === selected));
      if (write) changed();
    };

    const select = (id: string | null, scroll = false) => {
      selected = id && panels.has(id) ? id : null;
      render();
      if (scroll && selected) reveal(panels.get(selected)!);
    };

    for (const button of lossButtons) {
      button.addEventListener('click', () => {
        const id = button.dataset.lxLoss!;
        loss = loss === id ? null : id;
        render();
      });
    }
    for (const node of nodes) {
      node.addEventListener('click', () => {
        const id = node.dataset.lxSource!;
        select(selected === id ? null : id);
      });
    }
    // An identity's sources open the source's panel, which can be far below.
    for (const chip of chips) chip.addEventListener('click', () => select(chip.dataset.lxSourceSelect!, true));

    const reset = () => {
      loss = null;
      selected = null;
    };

    return {
      view,
      hasSource: (id) => panels.has(id),
      hasLoss: (id) => losses.has(id),
      reset,
      // A link restores the loss and the source it names, and a value that
      // names neither is ignored.
      restore: (params) => {
        reset();
        const wantedLoss = params.get(LOSS_PARAM);
        if (wantedLoss && losses.has(wantedLoss)) loss = wantedLoss;
        const wanted = params.get(SOURCE_PARAM);
        if (wanted && panels.has(wanted)) selected = wanted;
      },
      state: () => ({ loss, source: selected }),
      render,
    };
  }

  function start(root: HTMLElement) {
    const app = root.querySelector<HTMLElement>('[data-lx-app]');
    const familyButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-lx-family]')];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-lx-view]')];
    const journey = root.querySelector<HTMLElement>('[data-lx-journey]');
    const defaultFamily = root.dataset.lxDefaultFamily ?? '';
    let current: Family | undefined;
    let audit: Audit | null = null;
    let auditing = false;

    // The default view, family and path write no parameter, so a link from
    // before there were views, families or paths and a link to the defaults
    // are the same link. Each view writes its own parameters and removes the
    // other's.
    const writeUrl = () => {
      if (!current) return;
      try {
        const url = new URL(location.href);
        if (auditing && audit) {
          const state = audit.state();
          for (const param of JOURNEY_PARAMS) url.searchParams.delete(param);
          url.searchParams.set(VIEW_PARAM, AUDIT);
          if (state.loss) url.searchParams.set(LOSS_PARAM, state.loss);
          else url.searchParams.delete(LOSS_PARAM);
          if (state.source) url.searchParams.set(SOURCE_PARAM, state.source);
          else url.searchParams.delete(SOURCE_PARAM);
          history.replaceState(history.state, '', url);
          return;
        }
        for (const param of AUDIT_PARAMS) url.searchParams.delete(param);
        const state = current.state();
        if (current.id === defaultFamily) url.searchParams.delete(FAMILY_PARAM);
        else url.searchParams.set(FAMILY_PARAM, current.id);
        if (state.path) url.searchParams.set(PATH_PARAM, state.path);
        else url.searchParams.delete(PATH_PARAM);
        url.searchParams.set(STAGE_PARAM, state.stage);
        if (state.object) url.searchParams.set(OBJECT_PARAM, state.object);
        else url.searchParams.delete(OBJECT_PARAM);
        history.replaceState(history.state, '', url);
      } catch {
        // A sandboxed frame can refuse replaceState; the explorer works without it.
      }
    };

    const all = [...root.querySelectorAll<HTMLElement>('[data-lx-family-view]')]
      .map((view) => family(view, writeUrl))
      .filter((one): one is Family => one !== null);
    const auditElement = root.querySelector<HTMLElement>('[data-lx-audit]');
    audit = auditElement ? auditView(auditElement, writeUrl) : null;
    if (!app || all.length === 0) return;
    const home = all.find((one) => one.id === defaultFamily) ?? all[0];

    const show = () => {
      if (journey) journey.hidden = auditing;
      if (audit) audit.view.hidden = !auditing;
      for (const button of viewButtons) {
        button.setAttribute('aria-pressed', String((button.dataset.lxView === AUDIT) === auditing));
      }
      for (const one of all) one.view.hidden = one !== current;
      for (const button of familyButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.lxFamily === current?.id));
      }
    };

    // Another family starts afresh, at its default path and its first stage
    // with nothing selected: no path, stage or object of the family left
    // behind means anything in it.
    const chooseFamily = (id: string) => {
      const target = all.find((one) => one.id === id);
      if (!target || target === current) return;
      target.reset();
      current = target;
      show();
      target.render();
    };
    for (const button of familyButtons) button.addEventListener('click', () => chooseFamily(button.dataset.lxFamily!));

    // Either view starts afresh when it is chosen: the audit view with no
    // loss and no source, the change journey in the default family at its
    // default path and first stage with nothing selected.
    const chooseView = (id: string) => {
      const toAudit = id === AUDIT;
      if (toAudit === auditing || (toAudit && !audit)) return;
      auditing = toAudit;
      current = home;
      current.reset();
      audit?.reset();
      show();
      current.render(!auditing);
      if (auditing) audit!.render();
    };
    for (const button of viewButtons) button.addEventListener('click', () => chooseView(button.dataset.lxView!));

    // A link opens the audit view when it names it, or a source or a loss of
    // it. Otherwise it opens the family it names, or else the one its stage,
    // its path or its object belongs to, in that order.
    const params = new URLSearchParams(location.search);
    const named = (param: string, has: (one: Family, value: string) => boolean) => {
      const value = params.get(param);
      return value ? all.find((one) => has(one, value)) : undefined;
    };
    auditing =
      audit !== null &&
      (params.get(VIEW_PARAM) === AUDIT ||
        audit.hasSource(params.get(SOURCE_PARAM) ?? '') ||
        audit.hasLoss(params.get(LOSS_PARAM) ?? ''));
    if (auditing) {
      current = home;
      current.reset();
      audit!.restore(params);
    } else {
      current =
        named(FAMILY_PARAM, (one, value) => one.id === value) ??
        named(STAGE_PARAM, (one, value) => one.owns(value)) ??
        named(PATH_PARAM, (one, value) => one.hasPath(value)) ??
        named(OBJECT_PARAM, (one, value) => one.hasObject(value)) ??
        home;
      current.restore(params);
    }

    app.hidden = false;
    root.dataset.lxReady = '';
    show();
    current.render(false);
    if (auditing) audit!.render(false);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-lx]')) start(root);
</script>
