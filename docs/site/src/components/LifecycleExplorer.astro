              {loss.label}
            </button>
          ))
        }
      </div>
      <p class="lx__path-summary" data-lx-loss-summary="">
        Choose a loss to mark what each source keeps after it.
      </p>
      {
        audit.losses.map((loss) => (
          <p class="lx__path-summary" data-lx-loss-summary={loss.id} hidden>
