            {node.gap && (
              <p class="lx__limits" {...part('node', 'gap')}>
                <span class="lx__label">Gap</span> {node.gap}
              </p>
            )}
            <p class="lx__links">
              {node.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </p>
          </div>
        ))
      }

      <div class="lx__map">
        <p class="lx__map-title">What the relationships say</p>
        <ul class="lx__distinctions">
          {
