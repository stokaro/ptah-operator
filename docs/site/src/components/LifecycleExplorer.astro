                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="lx__hint" data-lx-source-hint>
        Select a source to see what it records, what it cannot establish and what reads it.
      </p>
      {
        audit.sources.map((source) => (
          <div class="lx__object" data-lx-source-panel={source.id} hidden>
            <p class="lx__panel-title">
              <span>{source.label}</span>
              <span class="lx__node-kind">{groupLabel.get(source.group)}</span>
            </p>
            <p {...part('source', 'records')}>
              <span class="lx__label">Records</span> {source.records}
            </p>
            <p {...part('source', 'establishes')}>
              <span class="lx__label">Establishes</span> {source.establishes}
            </p>
            <p class="lx__limits" {...part('source', 'cannot')}>
              <span class="lx__label">Cannot establish</span> {source.cannot}
            </p>
            <div {...part('source', 'ids')}>
              <span class="lx__label">Joins the others by</span>
              <ul class="lx__ids">
                {source.ids.map((id) => (
                  <li>{id}</li>
                ))}
              </ul>
            </div>
            <div class="lx__inspect" {...part('source', 'readers')}>
              <span class="lx__label">Read it with</span>
              {source.readers.map((reader) => (
                <div class="lx__command">
                  {reader.command ? (
                    <pre><code>{reader.command}</code></pre>
                  ) : (
                    <p class="lx__system">{reader.system}</p>
                  )}
                  <p>{reader.says}</p>
                </div>
              ))}
            </div>
            <p {...part('source', 'retention')}>
              <span class="lx__label">Kept</span> {source.retention}
            </p>
            <ul
              class="lx__survives"
              aria-label={`What is left of ${source.label} after a loss`}
              {...part('source', 'survives')}
            >
              {audit.losses.map((loss) => (
                <li data-lx-survives={loss.id} data-verdict={source.survives[loss.id].verdict}>
                  <strong>{loss.label}</strong>
                  <span class="lx__verdict-tag">{verdictLabel.get(source.survives[loss.id].verdict)}</span>
                  <span>
                    {source.survives[loss.id].text}{' '}
                    <span class="lx__basis">({basisLabel.get(source.survives[loss.id].basis)})</span>
                  </span>
                </li>
              ))}
            </ul>
            {identitiesOf(source.id).length > 0 && (
              <p {...part('source', 'names')}>
                <span class="lx__label">Names</span>{' '}
                {identitiesOf(source.id)
                  .map((identity) => identity.label)
                  .join(', ')}
              </p>
            )}
            {gapsOf(source.id).length > 0 && (
              <p class="lx__gap-links" {...part('source', 'gaps')}>
                <span class="lx__label">Gaps closed</span>
                {gapsOf(source.id).map((gap) => (
                  <a href={issueUrl(gap.issue)}>
                    #{gap.issue} in {gap.version}
                  </a>
                ))}
              </p>
            )}
            <p class="lx__links">
              {source.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </p>
          </div>
        ))
      }

      <div class="lx__map">
        <p class="lx__map-title" {...part('block', 'auditIdentities')}>
          Identities an audit keeps apart
        </p>
        <ul class="lx__identities" {...part('block', 'auditIdentities')}>
          {
            audit.identities.map((identity) => (
              <li data-lx-identity={identity.id}>
                <p>
                  <strong>{identity.label}.</strong> {identity.text}
                </p>
                <p class="lx__note">{identity.note}</p>
                <p class="lx__goto">
                  <span class="lx__label">Recorded in</span>
                  {identity.recordedIn.map((id) => (
                    <a class="lx__chip" href={sourceHref(id)} data-lx-source-select={id} data-lx-link>
                      {sourceById.get(id).label}
                    </a>
                  ))}
                </p>
              </li>
            ))
          }
        </ul>
        <ul class="lx__distinctions">
          {
            audit.distinctions.map((distinction) => (
              <li>{distinction}</li>
            ))
          }
        </ul>
      </div>

      <div class="lx__map" {...part('block', 'auditGaps')}>
        <p class="lx__map-title">Gaps since closed</p>
        <ul class="lx__gaps">
          {
            audit.gaps.map((gap) => (
              <li data-lx-gap={gap.issue}>
                <a href={issueUrl(gap.issue)}>#{gap.issue}</a>, closed in {gap.version}: <strong>{gap.title}.</strong>{' '}
                {gap.text}
              </li>
            ))
          }
        </ul>
        <p class="lx__deferred">
          Still deferred, as <a href={audit.deferredLink.href}>{audit.deferredLink.label}</a> record:{' '}
          {
            audit.deferred.map((item, index) => (
              <>
                {index > 0 && ' '}
                <strong>{item.title}.</strong> {item.text}
              </>
            ))
          }
        </p>
      </div>

      <p class="lx__later">
        Read more:{' '}
        {
          audit.links.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
        .
      </p>
    </div>

    <div class="lx__objects" data-lx-objects data-lx-objects-model={JSON.stringify(objectMapModel)} hidden>
      <p class="lx__title">{objectMap.title}</p>
      <p class="lx__summary">{objectMap.summary}</p>

      <div class="lx__sources">
        {
          nodeGroups.map((group) => (
            <div class="lx__source-group" data-lx-node-group={group.id}>
              <p class="lx__map-title">{group.label}</p>
              <ul class="lx__nodes">
                {group.nodes.map((node) => (
                  <li class="lx__has-tip">
                    <button
                      type="button"
                      class="lx__node"
                      data-lx-node={node.id}
                      aria-pressed="false"
                      aria-describedby={tipId('map', node.id)}
                    >
                      <span class="lx__node-label">
                        {breakable(node.label).map((part, index) => (
                          <>
                            {index > 0 && <wbr />}
                            {part}
                          </>
                        ))}
                      </span>
                      {node.kind !== node.label && <span class="lx__node-kind">{node.kind}</span>}
                      <span class="lx__node-rel" data-lx-rel />
                    </button>
                    <span class="lx__tip" role="tooltip" id={tipId('map', node.id)} data-lx-tip={node.hint}>
                      {node.hint}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <ul class="lx__legend" aria-label="Relationship types">
