              <span>
                <strong>{type.label}</strong> {type.text}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="lx__hint" data-lx-node-hint>
        Select an object to see what it holds, who writes it, whether it can change and what deleting it does. The
        objects related to it are marked with the relationship.
      </p>
      {
        objectMap.nodes.map((node) => (
          <div class="lx__object" data-lx-node-panel={node.id} hidden>
            <p class="lx__panel-title">
              <span>
                {breakable(node.label).map((part, index) => (
                  <>
                    {index > 0 && <wbr />}
                    {part}
                  </>
                ))}
              </span>
              <span class="lx__node-kind">
                {node.kind !== node.label && `${node.kind} · `}
                {nodeGroupLabel.get(node.group)}
              </span>
            </p>
            <p {...part('node', 'holds')}>
              <span class="lx__label">Holds</span> {node.holds}
            </p>
            <p {...part('node', 'writtenBy')}>
              <span class="lx__label">Written by</span> {node.writtenBy}
            </p>
            <p {...part('node', 'operator')}>
              <span class="lx__label">The operator</span> {node.operator}
            </p>
            <p {...part('node', 'scope')}>
              <span class="lx__label">Where</span> {scopeLabel.get(node.scope)}
            </p>
            <p>
              <span class="lx__label">Family</span> {familiesOf(node)}
            </p>
            <p data-lx-change={node.change.verdict} {...part('node', 'change')}>
              <span class="lx__label">Changes</span>{' '}
              <span class="lx__verdict-tag">{changeLabel.get(node.change.verdict)}</span> {node.change.text}
            </p>
            <p {...part('node', 'deletion')}>
              <span class="lx__label">Deleting it</span> {node.deletion}
            </p>
            <ul class="lx__relations" aria-label={`How ${node.label} relates to the others`}>
              {nodeRelations(node.id).map((relation) => (
                <li data-type={relation.type}>
                  <span class="lx__swatch" aria-hidden="true" />
                  <span>
                    <strong>{relation.label}</strong>{' '}
                    <a class="lx__link" href={nodeHref(relation.other)} data-lx-node-select={relation.other} data-lx-link>
                      {breakable(nodeById.get(relation.other).label).map((part, index) => (
                        <>
                          {index > 0 && <wbr />}
                          {part}
                        </>
                      ))}
                    </a>
                    . {relation.text}
                  </span>
                </li>
              ))}
            </ul>
            <div class="lx__inspect" {...part('node', 'inspect')}>
              <span class="lx__label">Inspect</span>
              {node.inspect.map((step) => (
                <div class="lx__command">
                  <pre><code>{step.command}</code></pre>
                  <p>{step.says}</p>
                </div>
              ))}
