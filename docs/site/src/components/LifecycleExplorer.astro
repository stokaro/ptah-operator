              </div>
              <p {...part('wstage', 'goal')}>{stage.goal}</p>
              <p {...part('wstage', 'person')}>
                <span class="lx__label">You</span> {stage.person}
              </p>
              <div class="lx__inspect" {...part('wstage', 'inspect')}>
                <span class="lx__label">{stage.family === 'outside' ? 'Where' : 'Commands'}</span>
                {stage.inspect.map((step) =>
                  step.command ? (
                    <div class="lx__command">
                      <pre><code>{step.command}</code></pre>
                      <p>{step.says}</p>
                    </div>
                  ) : (
                    <div class="lx__command">
                      <p>
                        <strong>{step.system}</strong> {step.says}
                      </p>
                    </div>
                  ),
                )}
              </div>
              <p data-lx-wpart="operator" {...part('wstage', 'operator')}>
                <span class="lx__label">The operator</span>{' '}
                <span class="lx__mark" data-mark="shipped">
                  {markLabel.get('shipped')}
                </span>{' '}
                {stage.operator}
              </p>
              {stage.decision && (
                <p data-lx-wpart="decision" {...part('wstage', 'decision')}>
                  <span class="lx__label">Decision</span> <strong>{decisionById.get(stage.decision).label}.</strong>{' '}
                  {stage.decisionText}
                </p>
              )}
              <p data-lx-wpart="gate" {...part('wstage', 'gate')}>
                <span class="lx__label">Moves on when</span>{' '}
                <span class="lx__mark" data-mark="proposed">
                  {markLabel.get('proposed')}
                </span>{' '}
                {stage.gate}
              </p>
              <p class="lx__done" {...part('wstage', 'done')}>
                <span class="lx__label">Done when</span> {stage.done}
              </p>
              {stage.limits && (
                <p class="lx__limits" {...part('wstage', 'limits')}>
                  <span class="lx__label">What it does not prove</span> {stage.limits}
                </p>
              )}
              <div class="lx__turn" role="group" aria-label={`What can stop ${stage.title}`}>
                <p class="lx__label">What can stop it. Choose one to see what it holds</p>
                <div class="lx__turn-options">
                  {stage.outcomes.map((one) => (
                    <button
                      type="button"
                      class="lx__turn-option"
                      data-lx-woutcome={one.outcome}
                      data-outcome={one.outcome}
                      aria-pressed="false"
                    >
                      <strong>{outcomeById.get(one.outcome).label}</strong>
                    </button>
                  ))}
                </div>
              </div>
              {stage.outcomes.map((one) => (
                <div class="lx__wstop" data-lx-wstop={one.outcome} hidden>
                  <p>
                    <span class="lx__label">Here</span> {one.text}
                  </p>
                  <p>
                    <span class="lx__label">Clears it</span> {one.recovery}
                  </p>
                  <p>
                    <span class="lx__label">Held</span>{' '}
                    {heldAfter(index) ? `${heldAfter(index)}, until it is cleared.` : 'Nothing: no stage follows it.'}
                  </p>
                  {one.journey && (
                    <p>
                      <span class="lx__label">In the change journey</span>{' '}
                      <a href={pathHref(one.journey)} data-lx-open data-lx-link>
                        {pathOf(one.journey).label}
                      </a>
                    </p>
                  )}
                </div>
              ))}
              <p class="lx__goto" {...part('wstage', 'objects')}>
                <span class="lx__label">Objects</span>
                {stage.objects.map((id) => (
                  <a class="lx__chip" href={nodeHref(id)} data-lx-open data-lx-link>
                    {breakable(nodeById.get(id).label).map((part, at) => (
                      <>
                        {at > 0 && <wbr />}
                        {part}
                      </>
                    ))}
                  </a>
                ))}
              </p>
              <p class="lx__links">
                {stage.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </p>
            </div>
          ))
        }
      </div>

      <div class="lx__map" {...part('block', 'workflowPreconditions')}>
        <p class="lx__map-title">Before the first stage</p>
        <ul class="lx__identities">
          {
            workflow.preconditions.map((precondition) => (
              <li data-lx-precondition={precondition.id}>
                <p>
                  <strong>{precondition.title}.</strong> {precondition.text}
                </p>
                <p class="lx__goto">
                  <span class="lx__label">Objects</span>
                  {precondition.objects.map((id) => (
                    <a class="lx__chip" href={nodeHref(id)} data-lx-open data-lx-link>
                      {nodeById.get(id).label}
                    </a>
                  ))}
                </p>
                <p class="lx__links">
                  {precondition.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lx__map">
        <p class="lx__map-title">What can stop a stage</p>
        <ul class="lx__gaps">
          {
            workflow.outcomes.map((outcome) => (
              <li data-lx-woutcome-text={outcome.id}>
                <strong>{outcome.label}.</strong> {outcome.text}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lx__map" {...part('block', 'workflowDecisions')}>
        <p class="lx__map-title">What each decision covers</p>
        <ul class="lx__identities">
          {
            workflow.decisions.map((decision) => (
              <li data-lx-decision={decision.id}>
                <p>
                  <strong>{decision.label}</strong>
                  {decision.node && (
                    <>
                      {' · '}
