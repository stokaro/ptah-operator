---
/* One recorded run: the terminal frame, and the transcript inside it.
 *
 * The frame plays where it stands. At rest it is as tall as the session it
 * carries, so the listing is there to be read; pressing Play turns it into a
 * terminal, one fixed box that keeps its size for the rest of the run.
 *
 * The transcript in the markup is the page. A reader without JavaScript, a
 * screen reader and a crawler all get the whole session; the player hides that
 * copy from sight and replays the same events into the screen above it. Both
 * come from demo/recordings/runs.json, so neither can drift from the other.
 */
import { transcript } from '../../public/demo/transcript.mjs';

interface Props {
	id: string;
	title: string;
	events: [string, string?][];
	where?: string;
}

const { id, title, events, where } = Astro.props;
const firstSync = events.find(([kind]) => kind === 'sync');
---

<!-- data-demo-static: the transcript stays on the page and the player waits to
	be asked. A documentation page that started typing at a reader who scrolled
	past it would be taking the page away from them. -->
<div class="term demo not-content" data-demo data-demo-static data-demo-scenario={id}>
	<div class="term-bar">
		<span class="demo-where">{where ?? `sh · ${id}`}</span>
		<span class="demo-sync" data-demo-sync hidden>{firstSync?.[1] ?? ''}</span>
		<span class="demo-controls" data-demo-controls hidden>
			<button
				class="demo-btn demo-btn-speed"
				type="button"
				data-demo-speed
				aria-label="Playback speed, 1×. Press to change."
				title="Speed"><span data-demo-speed-label>1×</span></button
			>
			<button class="demo-btn" type="button" data-demo-toggle aria-label="Play the recording" title="Play">
				<svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"
					><path d="M5.25 3.5h1.9v9h-1.9zM8.85 3.5h1.9v9h-1.9z" fill="currentColor"></path></svg
				>
				<svg class="i-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"
					><path d="M5.5 3.4l7 4.6-7 4.6z" fill="currentColor"></path></svg
				>
				<span class="i-pause">Pause</span><span class="i-play">Play</span>
			</button>
			<button class="demo-btn" type="button" data-demo-replay aria-label="Replay the recording" title="Replay" hidden>
				<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"
					><path
						d="M13.2 8a5.2 5.2 0 1 1-1.75-3.9"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"></path><path
						d="M12.4 1.9v2.9H9.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path></svg
				>
				<span>Replay</span>
			</button>
		</span>
	</div>

	<pre class="demo-screen" data-demo-screen aria-hidden="true" hidden></pre>

	<pre class="demo-transcript" data-demo-transcript aria-label={`${title} transcript`} set:html={transcript(events)} />

	<!-- The rule at the foot of the frame is part of the frame, not part of the
		player: hidden until the first press, it took two pixels off the height
		the moment a reader asked for one. It sits at zero until something runs. -->
	<div class="demo-progress" data-demo-progress aria-hidden="true"><span></span></div>
</div>
