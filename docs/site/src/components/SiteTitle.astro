---
/**
 * The brand row of the header: the mark and "Ptah" link to this guide's root,
 * "Operator" names which guide it is, and the version picker switches operator
 * documentation versions. It is the row ptah.run and Ptah's documentation
 * carry, with the one word that says a reader is on the other site.
 *
 * The mark is the control a reader reaches for to go home, so it goes to this
 * guide's root rather than outward. Below 50rem the header hides both
 * "Operator" and the links beside it, which would otherwise leave a phone with
 * no way back and one outward link that looks like the way back and is not.
 * ptah.run and Ptah's documentation stay header links; HeaderLinks.astro
 * renders them first.
 *
 * The picker switches versions of THIS guide. The operator releases on its own
 * schedule, so the list it reads is this site's versions.json and never Ptah's.
 * The picker itself is served from the Pages root and shared by every version;
 * VersionPicker.astro is only its mount point.
 */
import logo from '../assets/logo.svg';
import VersionPicker from './VersionPicker.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="ptah-brand">
  <a class="ptah-brand__site" href={siteTitleHref} translate="no">
    <img src={logo.src} alt="" width="20" height="20" />
    Ptah
  </a>
  <a class="ptah-brand__docs" href={siteTitleHref}>Operator</a>
  <VersionPicker />
</div>

<style>
  /* The brand cell of the concept: mark 20px, "Ptah" 600 14.5px, "Docs" 400
   * 14.5px in gray-3, and the version pill at the cell's right edge. The row
   * fills the header's title-wrapper (header.css makes that wrapper the 16rem
   * cell) so the pill's auto margin reaches the cell's inner edge. */
  .ptah-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
  }

  .ptah-brand__site {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-white);
    font-size: 0.90625rem;
    font-weight: 600;
    line-height: 1;
    /* Invisible in the centered cell; lifts the 15px line to a 25px target. */
    padding-block: 0.3125rem;
    text-decoration: none;
  }
  .ptah-brand__site:hover {
    color: var(--sl-color-white);
  }
  .ptah-brand__site img {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 5px;
    /* The mark is a dark square; on the dark page tokens.css gives the ring a
     * hairline color, on the light page it is transparent. */
    outline: 1px solid var(--ptah-logo-ring, transparent);
  }

  .ptah-brand__docs {
    color: var(--sl-color-gray-3);
    font-size: 0.90625rem;
    font-weight: 400;
    line-height: 1;
    padding-block: 0.3125rem;
    text-decoration: none;
  }
  .ptah-brand__docs:hover {
    color: var(--sl-color-text-accent);
  }

  /* Phone: no "Operator", the header has three 44px controls to fit at the
   * right. The picker's own stylesheet shrinks the pill. */
  @media (width < 50rem) {
    .ptah-brand__docs {
      display: none;
    }
  }
</style>
