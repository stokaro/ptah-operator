---
/**
 * Starlight's content wrapper, with the FAQ's tag rail and field in front of
 * its questions.
 *
 * The rail belongs above the content, which on every other page is exactly what
 * Starlight renders here, so this override adds one element for one route and
 * is otherwise the upstream component.
 *
 * It is an override rather than a component the page imports, because the page
 * cannot be MDX. Every question declares its anchor as `### Question {#anchor}`,
 * and MDX reads a brace as the start of an expression: converting the page
 * turns every anchor into a parse error. The anchors are the page's interface --
 * people link to single questions -- so the page stays Markdown and the
 * component comes to it.
 */
import '@astrojs/starlight/style/markdown.css';
import FaqFilter from './FaqFilter.astro';
import MermaidRuntime from './MermaidRuntime.astro';

const { entry } = Astro.locals.starlightRoute;

// Matched on the entry id rather than on the URL, so a base path or a version
// prefix cannot change the answer.
const isFaq = entry.id === 'faq' || entry.id === 'faq.md';

// Read from the source for the same reason the count below is: the rendered
// tree is downstream of this component, so the page cannot be asked whether it
// drew any diagrams. A page with no fence never fetches the library.
const hasDiagrams = /^```mermaid\s*$/m.test(entry.body ?? '');

// The questions are `###` under a `##` group, so the count comes from the
// source rather than from a number kept in step by hand.
const questionCount = (entry.body?.match(/^### /gm) ?? []).length;

// The generated field pages, recognized by the header `make docs-reference`
// writes. Their first column holds whole field paths, which are long enough to
// decide the column width on their own and leave the description a sliver; the
// class is what the stylesheet needs to divide those columns itself.
const isFieldReference = /^\| Field \| Type \| What it does \|$/m.test(entry.body ?? '');
---

{isFaq && <FaqFilter count={questionCount} />}
{hasDiagrams && <MermaidRuntime />}
<div
  class:list={['sl-markdown-content', isFaq && 'ptah-faq', isFieldReference && 'ptah-field-reference']}
>
  <slot />
</div>
