---
/**
 * The page title, carrying the words a reader searches for when they have the
 * failure rather than the vocabulary.
 *
 * A page's `searchAliases` are curated vocabulary. The FAQ's symptoms are the
 * same words, and the prose spells hardly any of them -- somebody who types
 * `tables still there` into the site search would reach nothing without this.
 * Pagefind reads them from the attribute pair below, and the ranking weight in
 * astro.config.mjs is what lifts the page above an incidental body match.
 *
 * Everything else is Starlight's own PageTitle, style block included: the
 * package exports neither the id constant nor a way to add an attribute, so
 * the component is restated rather than wrapped.
 */
const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const searchAliases = entry.data.searchAliases ?? [];
---

<h1
	id={PAGE_TITLE_ID}
	data-search-aliases={searchAliases.length > 0 ? searchAliases.join(' · ') : undefined}
	data-pagefind-meta={searchAliases.length > 0 ? 'searchAliases[data-search-aliases]' : undefined}
>{entry.data.title}</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
