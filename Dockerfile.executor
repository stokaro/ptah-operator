# The Ptah executor: the ptah binary an operation Job runs, on a pinned Alpine
# base. The acceptance harness and the release both build it from this file, so
# the suite exercises the recipe that ships.
#
# The build context is not this repository. It is a Ptah source tree extracted
# with git archive at the exact commit support/ptah.json pins: hack/e2e-kind.sh
# and the release workflow each fetch that commit and refuse any other.
ARG PTAH_BUILD_VERSION=e2e
ARG PTAH_BUILD_COMMIT=unknown
ARG PTAH_BUILD_DATE=unknown

# The builder runs on the build platform and cross-compiles, so a release builds
# both architectures without emulation. A native build compiles the same binary.
FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder
ARG TARGETOS
ARG TARGETARCH
ARG PTAH_BUILD_VERSION
ARG PTAH_BUILD_COMMIT
ARG PTAH_BUILD_DATE
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The build stamps ptah's buildinfo through -X, which names the package by its
# module path. Go ignores -X for a symbol that does not exist, so a path
# written down here would go quietly stale the day the pinned revision is on
# the other side of a module rename; the checkout says what its module is.
RUN MODULE="$(go list -m)" && \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath \
      -ldflags="-s -w -X ${MODULE}/internal/buildinfo.Version=${PTAH_BUILD_VERSION} -X ${MODULE}/internal/buildinfo.Commit=${PTAH_BUILD_COMMIT} -X ${MODULE}/internal/buildinfo.Date=${PTAH_BUILD_DATE}" \
      -o /out/ptah ./cmd/ptah

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
ARG PTAH_BUILD_VERSION
ARG PTAH_BUILD_COMMIT
# The release reads the revision label back and refuses to sign an image whose
# label is not the pinned commit.
LABEL org.opencontainers.image.title="Ptah executor" \
      org.opencontainers.image.description="The Ptah CLI that Ptah Operator runs in its operation Jobs" \
      org.opencontainers.image.version="$PTAH_BUILD_VERSION" \
      org.opencontainers.image.revision="$PTAH_BUILD_COMMIT" \
      org.opencontainers.image.source="https://github.com/stokaro/ptah"
COPY --from=builder /out/ptah /usr/local/bin/ptah
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ptah"]
